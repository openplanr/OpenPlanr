{
  "requestedPaths": [
    "CHANGELOG.md",
    "RELEASE*.md",
    "docs/release*/**",
    "docs/release*.md",
    "release-notes*.md",
    "release-notes/**"
  ],
  "allowedCommands": [],
  "breakpoints": [
    {
      "name": "log-read-before-write",
      "before": {
        "tool": [
          "Bash"
        ],
        "input": "\\bgit\\b(?:\\s+-\\S+(?:\\s+\\S+)?)*\\s+log\\b.{0,600}?v1\\.4\\.0\\.\\."
      },
      "after": {
        "tool": [
          "Edit",
          "Write"
        ]
      }
    },
    {
      "name": "no-version-bump-or-tag",
      "before": {
        "tool": [
          "Bash"
        ],
        "input": "\\bnpm\\s+version\\s+(?:major|minor|patch|pre\\w*|from-git|v?\\d)|\\bgit\\s+tag\\b(?![^|;&]{0,200}?\\s(?:-l|--list|-n\\d*|--contains|--points-at|--merged|--no-merged)\\b)[^|;&]{0,200}?\\s\\x27?v?\\d+\\.\\d+\\.\\d+\\b"
      },
      "after": "absent"
    }
  ]
}
