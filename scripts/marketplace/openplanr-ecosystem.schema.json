{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/openplanr-ecosystem.schema.json",
  "title": "OpenPlanr workspace ecosystem ledger (ecosystem.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "releaseState",
    "repositoryIntent",
    "remoteState",
    "workspace",
    "protocol",
    "components",
    "compatibility",
    "binaries",
    "publicCompatibility",
    "catalogs",
    "adapters",
    "schemas",
    "registries",
    "generatedSurfaces"
  ],
  "properties": {
    "kind": { "const": "openplanr-ecosystem" },
    "schemaVersion": { "const": "1.0.0" },
    "releaseState": { "const": "local-candidate" },
    "repositoryIntent": { "const": "openplanr/OpenPlanr" },
    "remoteState": { "const": "not-queried" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "private", "workspaces", "manifestDigest"],
      "properties": {
        "package": { "const": "openplanr-workspace" },
        "version": { "$ref": "#/$defs/semver" },
        "private": { "const": true },
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "manifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "additiveVersions", "supportedReaders"],
      "properties": {
        "current": { "$ref": "#/$defs/semver" },
        "additiveVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semver" }
        },
        "supportedReaders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.x$" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli",
        "pipeline",
        "protocol",
        "operate",
        "artifact",
        "design",
        "skillRuntime",
        "integrations",
        "dashboard"
      ],
      "properties": {
        "cli": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "openplanr" },
            "path": { "const": "packages/cli" },
            "publication": { "const": "public" }
          }
        },
        "pipeline": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "planr-pipeline" },
            "path": { "const": "packages/pipeline" },
            "publication": { "const": "public" }
          }
        },
        "protocol": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "@openplanr/protocol" },
            "path": { "const": "packages/protocol" },
            "publication": { "const": "public" }
          }
        },
        "operate": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "@openplanr/operate" },
            "path": { "const": "packages/operate" },
            "publication": { "const": "private" }
          }
        },
        "artifact": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "@openplanr/artifact" },
            "path": { "const": "packages/artifact" },
            "publication": { "const": "private" }
          }
        },
        "design": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "@openplanr/design" },
            "path": { "const": "packages/design" },
            "publication": { "const": "private" }
          }
        },
        "skillRuntime": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "@openplanr/skill-runtime" },
            "path": { "const": "packages/skill-runtime" },
            "publication": { "const": "private" }
          }
        },
        "integrations": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "@openplanr/integrations" },
            "path": { "const": "packages/integrations" },
            "publication": { "const": "private" }
          }
        },
        "dashboard": {
          "$ref": "#/$defs/component",
          "properties": {
            "package": { "const": "@openplanr/dashboard-app" },
            "path": { "const": "apps/dashboard" },
            "publication": { "const": "private" }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cliOptionalPipeline", "publicArtifacts"],
      "properties": {
        "cliOptionalPipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version", "exact"],
          "properties": {
            "package": { "const": "planr-pipeline" },
            "version": { "$ref": "#/$defs/semver" },
            "exact": { "const": true }
          }
        },
        "publicArtifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selfContained", "privateWorkspaceDependenciesAllowed"],
          "properties": {
            "selfContained": { "const": true },
            "privateWorkspaceDependenciesAllowed": { "const": false }
          }
        }
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "pipeline"],
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planr", "openplanr", "opr"],
          "properties": {
            "planr": { "const": "./bin/planr.js" },
            "openplanr": { "const": "./bin/planr.js" },
            "opr": { "const": "./bin/planr.js" }
          }
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planr-pipeline"],
          "properties": {
            "planr-pipeline": { "const": "bin/planr-pipeline.mjs" }
          }
        }
      }
    },
    "publicCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelineExportKeys", "pipelineRootSymbols"],
      "properties": {
        "pipelineExportKeys": { "$ref": "#/$defs/count" },
        "pipelineRootSymbols": { "$ref": "#/$defs/count" }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "skills", "roles", "rules", "taskKinds", "outputs", "outputPaths"],
      "properties": {
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "digest",
            "rootCommands",
            "pipelineMachineLeaves",
            "frozenClaudeDocuments",
            "negativeContracts"
          ],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "digest": { "$ref": "#/$defs/digest" },
            "rootCommands": { "$ref": "#/$defs/count" },
            "pipelineMachineLeaves": { "$ref": "#/$defs/count" },
            "frozenClaudeDocuments": { "$ref": "#/$defs/count" },
            "negativeContracts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/negativeContract" }
            }
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "count", "ids", "aliases", "membershipDigest"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "digest": { "$ref": "#/$defs/digest" },
            "count": { "$ref": "#/$defs/count" },
            "ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/planrId" }
            },
            "aliases": { "type": "array", "maxItems": 0 },
            "membershipDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "count", "ids", "aliases"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "digest": { "$ref": "#/$defs/digest" },
            "count": { "$ref": "#/$defs/count" },
            "ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/planrId" }
            },
            "aliases": { "type": "array", "maxItems": 0 }
          }
        },
        "rules": { "$ref": "#/$defs/countedFile" },
        "taskKinds": { "$ref": "#/$defs/countedFile" },
        "outputs": { "$ref": "#/$defs/countedFile" },
        "outputPaths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "count", "outputCatalogDigest"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "digest": { "$ref": "#/$defs/digest" },
            "count": { "$ref": "#/$defs/count" },
            "outputCatalogDigest": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "hosts", "generatedAssets"],
      "properties": {
        "registry": { "$ref": "#/$defs/digestedFile" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "capabilityLevel"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "version": { "$ref": "#/$defs/semver" },
              "capabilityLevel": { "enum": ["artifact", "workflow", "product"] }
            }
          }
        },
        "generatedAssets": { "$ref": "#/$defs/countedFile" }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserved", "successors", "additive", "total"],
      "properties": {
        "preserved": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "distribution"],
          "properties": {
            "count": { "$ref": "#/$defs/count" },
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["v1.0.0", "v1.1.0", "v1.2.0", "v1.3.0", "v1.4.0", "v2.0.0"],
              "properties": {
                "v1.0.0": { "$ref": "#/$defs/count" },
                "v1.1.0": { "$ref": "#/$defs/count" },
                "v1.2.0": { "$ref": "#/$defs/count" },
                "v1.3.0": { "$ref": "#/$defs/count" },
                "v1.4.0": { "$ref": "#/$defs/count" },
                "v2.0.0": { "$ref": "#/$defs/count" }
              }
            }
          }
        },
        "successors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "count"],
          "properties": {
            "protocolVersion": { "$ref": "#/$defs/semver" },
            "count": { "$ref": "#/$defs/count" }
          }
        },
        "additive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "byVersion"],
          "properties": {
            "count": { "$ref": "#/$defs/count" },
            "byVersion": {
              "type": "object",
              "additionalProperties": false,
              "required": ["v1.5.0", "v1.6.0", "v1.7.0", "v1.8.0", "v1.13.0"],
              "properties": {
                "v1.5.0": { "$ref": "#/$defs/count" },
                "v1.6.0": { "$ref": "#/$defs/count" },
                "v1.7.0": { "$ref": "#/$defs/count" },
                "v1.8.0": { "$ref": "#/$defs/count" },
                "v1.13.0": { "$ref": "#/$defs/count" }
              }
            }
          }
        },
        "total": { "$ref": "#/$defs/count" }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserved",
        "canonicalCatalogs",
        "protocol15Catalogs",
        "protocol16Catalogs",
        "protocol17Catalogs",
        "protocol113Catalogs",
        "capturedEvaluationContracts"
      ],
      "properties": {
        "preserved": { "$ref": "#/$defs/countedDirectory" },
        "canonicalCatalogs": { "$ref": "#/$defs/countedDirectory" },
        "protocol15Catalogs": { "$ref": "#/$defs/countedDirectory" },
        "protocol16Catalogs": { "$ref": "#/$defs/countedDirectory" },
        "protocol17Catalogs": { "$ref": "#/$defs/countedDirectory" },
        "protocol113Catalogs": { "$ref": "#/$defs/countedDirectory" },
        "capturedEvaluationContracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lifecycle", "hostProfiles", "graders"],
          "properties": {
            "lifecycle": { "const": "byte-preserved" },
            "hostProfiles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest", "registryId", "count"],
              "properties": {
                "path": { "$ref": "#/$defs/relativePath" },
                "digest": { "$ref": "#/$defs/digest" },
                "registryId": { "type": "string", "pattern": "^ehpr_[a-f0-9]{32}$" },
                "count": { "$ref": "#/$defs/count" }
              }
            },
            "graders": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest", "registryId", "count"],
              "properties": {
                "path": { "$ref": "#/$defs/relativePath" },
                "digest": { "$ref": "#/$defs/digest" },
                "registryId": { "type": "string", "pattern": "^egrr_[a-f0-9]{32}$" },
                "count": { "$ref": "#/$defs/count" }
              }
            }
          }
        }
      }
    },
    "generatedSurfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactShell", "landingWorkflow"],
      "properties": {
        "artifactShell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "shellVersion", "assetCount"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "digest": { "$ref": "#/$defs/digest" },
            "shellVersion": { "$ref": "#/$defs/semver" },
            "assetCount": { "$ref": "#/$defs/count" }
          }
        },
        "landingWorkflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalog", "generatedAssets"],
          "properties": {
            "catalog": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest",
                "workflowId",
                "workflowVersion",
                "catalogHash",
                "authority"
              ],
              "properties": {
                "path": { "$ref": "#/$defs/relativePath" },
                "digest": { "$ref": "#/$defs/digest" },
                "workflowId": { "$ref": "#/$defs/planrId" },
                "workflowVersion": { "$ref": "#/$defs/semver" },
                "catalogHash": { "$ref": "#/$defs/digest" },
                "authority": { "const": "none" }
              }
            },
            "generatedAssets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest", "assetCount", "workflowCatalogDigest"],
              "properties": {
                "path": { "$ref": "#/$defs/relativePath" },
                "digest": { "$ref": "#/$defs/digest" },
                "assetCount": { "$ref": "#/$defs/count" },
                "workflowCatalogDigest": { "$ref": "#/$defs/digest" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "planrId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^planr-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "path", "publication", "manifestDigest"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "path": { "$ref": "#/$defs/relativePath" },
        "publication": { "enum": ["public", "private"] },
        "manifestDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "digestedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "countedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "count"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "count": { "$ref": "#/$defs/count" }
      }
    },
    "countedDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "path"],
      "properties": {
        "count": { "$ref": "#/$defs/count" },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "negativeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negativeContractId",
        "forbiddenArgvPrefix",
        "forbiddenPaths",
        "reason",
        "testRefs"
      ],
      "properties": {
        "negativeContractId": { "$ref": "#/$defs/identifier" },
        "forbiddenArgvPrefix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenPaths": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "testRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  }
}
