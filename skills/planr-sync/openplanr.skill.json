{
  "kind": "openplanr-skill-package",
  "schemaVersion": "1.0.0",
  "protocolVersion": "1.8.0",
  "skillId": "planr-sync",
  "skillVersion": "1.0.1",
  "entrypoint": "SKILL.md",
  "hosts": [
    "claude-code",
    "codex",
    "chatgpt",
    "cursor"
  ],
  "execution": "host-agent",
  "resources": [
    {
      "path": "references/tracker-connections.md",
      "kind": "reference",
      "hosts": [
        "claude-code",
        "codex",
        "chatgpt",
        "cursor"
      ],
      "executable": false
    },
    {
      "path": "scripts/sync.mjs",
      "kind": "script",
      "hosts": [
        "claude-code",
        "codex",
        "chatgpt",
        "cursor"
      ],
      "executable": true
    },
    {
      "path": "scripts/names.mjs",
      "kind": "script",
      "hosts": [
        "claude-code",
        "codex",
        "chatgpt",
        "cursor"
      ],
      "executable": false
    },
    {
      "path": "agents/openai.yaml",
      "kind": "agent-metadata",
      "hosts": [
        "codex",
        "chatgpt"
      ],
      "executable": false
    }
  ]
}
