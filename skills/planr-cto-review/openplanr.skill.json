{
  "kind": "openplanr-skill-package",
  "schemaVersion": "1.0.0",
  "protocolVersion": "1.8.0",
  "skillId": "planr-cto-review",
  "skillVersion": "2.0.0",
  "entrypoint": "SKILL.md",
  "hosts": [
    "claude-code",
    "codex",
    "chatgpt",
    "cursor"
  ],
  "execution": "host-agent",
  "resources": [
    {
      "path": "references/operate-advisor-contract.md",
      "kind": "reference",
      "hosts": ["claude-code", "codex", "chatgpt", "cursor"],
      "executable": false
    },
    {
      "path": "scripts/validate-note.mjs",
      "kind": "script",
      "hosts": ["claude-code", "codex", "chatgpt", "cursor"],
      "executable": true
    },
    {
      "path": "scripts/operate-review-note.mjs",
      "kind": "script",
      "hosts": ["claude-code", "codex", "chatgpt", "cursor"],
      "executable": false
    },
    {
      "path": "scripts/operate-review-contract.mjs",
      "kind": "script",
      "hosts": ["claude-code", "codex", "chatgpt", "cursor"],
      "executable": false
    },
    {
      "path": "scripts/errors.mjs",
      "kind": "script",
      "hosts": ["claude-code", "codex", "chatgpt", "cursor"],
      "executable": false
    },
    {
      "path": "agents/openai.yaml",
      "kind": "agent-metadata",
      "hosts": [
        "codex",
        "chatgpt"
      ],
      "executable": false
    }
  ]
}
