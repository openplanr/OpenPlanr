{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.11.0/design-implementation-handoff.schema.json",
  "x-openplanr-contract": {
    "id": "design-implementation-handoff",
    "version": "1.11.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "openplanr-design-implementation-handoff"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "superseded",
        "revoked"
      ]
    },
    "authority": {
      "const": "prepare-plan"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "selectedVariant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "ready",
                "attention",
                "blocked",
                "stale"
              ]
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "status",
            "digest"
          ]
        },
        "reviewHandoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "version",
            "contentDigest"
          ]
        }
      },
      "required": [
        "designId",
        "sourceRevision",
        "selectedVariant",
        "readiness",
        "reviewHandoff"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "kind": {
            "enum": [
              "design-revision",
              "selected-direction",
              "design-specification",
              "rendered-verification",
              "review-context",
              "review-feedback",
              "review-metadata",
              "review-handoff",
              "screen",
              "frame",
              "component",
              "state",
              "flow",
              "token",
              "review-decision",
              "element-anchor"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "revision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "anchor": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                },
                "required": [
                  "section"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "screenId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                },
                "required": [
                  "screenId"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "screenId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "elementId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                },
                "required": [
                  "screenId",
                  "elementId"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reviewId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "pinId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                },
                "required": [
                  "reviewId",
                  "pinId"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "path"
        ]
      },
      "maxItems": 10000
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "behavior",
              "visual-state",
              "responsive",
              "accessibility",
              "content-data-assumption",
              "constraint",
              "verification-intent"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "maxItems": 256,
            "minItems": 1
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "maxItems": 256,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "statement",
          "sourceRefs",
          "verification"
        ]
      },
      "maxItems": 10000,
      "minItems": 1
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "markdown": {
      "type": "string",
      "maxLength": 2097152
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "authority": {
          "const": "prepare-plan"
        }
      },
      "required": [
        "actorId",
        "approvedAt",
        "contentDigest",
        "authority"
      ]
    },
    "supersededBy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "contentDigest"
      ]
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "actorId",
        "revokedAt",
        "reason"
      ]
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "version",
    "status",
    "authority",
    "title",
    "basis",
    "sources",
    "requirements",
    "contentDigest",
    "markdown"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approval"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "supersededBy"
              ]
            },
            {
              "required": [
                "revocation"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approval",
          "supersededBy"
        ],
        "not": {
          "required": [
            "revocation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approval",
          "revocation"
        ],
        "not": {
          "required": [
            "supersededBy"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "approval"
              ]
            },
            {
              "required": [
                "supersededBy"
              ]
            },
            {
              "required": [
                "revocation"
              ]
            }
          ]
        }
      }
    }
  ]
}
