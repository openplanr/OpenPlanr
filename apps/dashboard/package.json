{
  "name": "@openplanr/dashboard-app",
  "version": "0.1.26",
  "private": true,
  "type": "module",
  "description": "Browser-safe local OpenPlanr planning and Operate dashboard",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "npm --prefix ../.. run test:browser:fixture --workspace=openplanr",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:architecture",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "test:brand:browser": "npm run build && node --test tests/browser/*.test.mjs",
    "check": "npm run test:architecture && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/source-code-pro": "5.3.1",
    "@openplanr/canvas": "0.0.1",
    "@openplanr/protocol": "0.19.0",
    "@tanstack/react-query": "5.108.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.3",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.14.1",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
