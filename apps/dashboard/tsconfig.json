{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@dashboard/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
