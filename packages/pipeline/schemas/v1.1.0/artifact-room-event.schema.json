{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/artifact-room-event.schema.json",
  "title": "OpenPlanr encrypted artifact-room event plaintext",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "roomId", "reviewOf", "kind", "createdAt", "payload"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "roomId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "reviewOf": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "kind": { "enum": ["pin", "reply", "pin_status", "recommendation", "owner_decision", "review_snapshot"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "pin" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/pin" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "reply" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pinId", "reply"],
            "properties": {
              "pinId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "reply": { "$ref": "#/$defs/reply" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "pin_status" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pinId", "status"],
            "properties": {
              "pinId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "status": { "enum": ["open", "addressed", "resolved"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "recommendation" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["author", "decision", "overall"],
            "properties": {
              "author": { "$ref": "#/$defs/author" },
              "decision": { "enum": ["pending", "approved", "changes_requested"] },
              "overall": { "type": "string", "maxLength": 65536 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "owner_decision" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision"],
            "properties": {
              "decision": { "enum": ["approved", "changes_requested"] },
              "overall": { "type": "string", "maxLength": 65536 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "review_snapshot" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["review"],
            "properties": { "review": { "$ref": "#/$defs/review" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "comment", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "author": { "$ref": "#/$defs/author" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "artifactId", "region", "viewport", "intent", "status", "comment", "replies", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "author": { "$ref": "#/$defs/author" },
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "variant": { "type": "string", "minLength": 1, "maxLength": 128 },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "w": { "type": "number", "minimum": 0, "maximum": 1 },
            "h": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 262144 }
          }
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planrId"],
          "properties": {
            "planrId": { "type": "string", "minLength": 1, "maxLength": 512 },
            "screen": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "intent": { "enum": ["fix", "improve", "question"] },
        "status": { "enum": ["open", "addressed", "resolved"] },
        "comment": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "replies": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/reply" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "reviewId", "reviewOf", "decision", "overall", "pins"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "reviewId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewOf": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "decision": { "enum": ["pending", "approved", "changes_requested"] },
        "overall": { "type": "string", "maxLength": 65536 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "pins": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/pin" } }
      }
    }
  }
}
