{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/artifact-room-signed-event.schema.json",
  "title": "OpenPlanr signed live-room ciphertext event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "protocolVersion", "roomId", "eventId", "sequence", "predecessor", "kind",
    "reviewOf", "authorRole", "authorKey", "capability", "createdAt", "iv", "ciphertext",
    "plaintextDigest", "ciphertextDigest", "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "protocolVersion": { "const": "2.0.0" },
    "roomId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "eventId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "predecessor": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "kind": { "enum": ["pin", "reply", "pin_status", "recommendation", "owner_decision", "review_snapshot"] },
    "reviewOf": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorRole": { "enum": ["reviewer", "owner"] },
    "authorKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "encoding", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ECDSA-P256-SHA256" },
        "encoding": { "const": "spki-base64url" },
        "keyId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{64,342}$" }
      }
    },
    "capability": { "enum": ["reviewer-write", "owner-verdict"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "iv": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$" },
    "ciphertext": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "plaintextDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ciphertextDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86,107}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "authorRole": { "const": "owner" } }, "required": ["authorRole"] },
      "then": {
        "properties": {
          "capability": { "const": "owner-verdict" },
          "kind": { "enum": ["owner_decision", "review_snapshot"] }
        }
      },
      "else": {
        "properties": {
          "capability": { "const": "reviewer-write" },
          "kind": { "enum": ["pin", "reply", "pin_status", "recommendation"] }
        }
      }
    }
  ]
}
