{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/browser-qa-gate.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "candidateRevision", "candidateDigest", "requirementDigest", "required", "status", "sessionBindingDigest", "resultDigest", "recordDigest"],
  "properties": {
    "kind": { "const": "browser-qa-gate" }, "schemaVersion": { "const": "1.0.0" }, "protocolVersion": { "const": "1.1.0" },
    "candidateRevision": { "type": "integer", "minimum": 1, "maximum": 2 },
    "candidateDigest": { "$ref": "#/$defs/digest" }, "requirementDigest": { "$ref": "#/$defs/digest" }, "required": { "type": "boolean" },
    "status": { "enum": ["passed", "failed", "blocked", "skipped"] },
    "sessionBindingDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "resultDigest": { "$ref": "#/$defs/digest" },
    "custodyVersion": { "const": "1.0.0" },
    "attestationHostId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "attestationHostVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "attestationDigest": { "$ref": "#/$defs/digest" },
    "evidenceBundleDigest": { "$ref": "#/$defs/digest" },
    "recordDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
