{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/ship-review-specialist-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "specialists"],
  "properties": {
    "kind": { "const": "ship-review-specialist-registry" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.1.0" },
    "specialists": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": { "$ref": "#/$defs/specialist" }
    }
  },
  "$defs": {
    "specialist": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "triggers", "capabilities", "resultKind", "authority"],
      "properties": {
        "id": { "enum": ["security", "performance", "migration", "api-contract", "data-integrity"] },
        "triggers": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "capabilities": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["candidate.read", "evidence.read", "finding.contribute"] } },
        "resultKind": { "const": "specialist-review-result" },
        "authority": { "const": "read-only-consolidated-review" }
      }
    }
  }
}
