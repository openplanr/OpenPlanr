{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/ship-risk-classification.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "input", "inputDigest", "selectedSpecialists", "reviewerRoster", "browserQa", "classificationDigest"],
  "properties": {
    "kind": { "const": "ship-risk-classification" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.1.0" },
    "input": { "$ref": "#/$defs/input" },
    "inputDigest": { "$ref": "#/$defs/digest" },
    "selectedSpecialists": { "$ref": "#/$defs/specialistIds" },
    "reviewerRoster": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "prefixItems": [{ "const": "qa-agent" }], "items": { "enum": ["qa-agent", "security", "performance", "migration", "api-contract", "data-integrity"] } },
    "browserQa": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "triggers", "requirementDigest"],
      "properties": {
        "required": { "type": "boolean" },
        "triggers": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["ui", "authentication", "session", "navigation", "network"] } },
        "requirementDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "classificationDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "specialistIds": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "enum": ["security", "performance", "migration", "api-contract", "data-integrity"] } },
    "repositoryPath": {
      "type": "object", "additionalProperties": false, "required": ["repositoryKey", "path"],
      "properties": { "repositoryKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "path": { "type": "string", "minLength": 1, "maxLength": 1024 } }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["subjectDigest", "changedPaths", "browserSurfaces", "contractChanges", "migrationChanges", "permissionEffects", "dataWrites", "performanceBudgets", "explicitRisks"],
      "properties": {
        "subjectDigest": { "$ref": "#/$defs/digest" },
        "changedPaths": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } },
        "browserSurfaces": { "type": "array", "maxItems": 5, "uniqueItems": true, "items": { "enum": ["ui", "authentication", "session", "navigation", "network"] } },
        "contractChanges": { "type": "boolean" },
        "migrationChanges": { "type": "boolean" },
        "permissionEffects": { "type": "boolean" },
        "dataWrites": { "type": "boolean" },
        "performanceBudgets": { "type": "boolean" },
        "explicitRisks": { "$ref": "#/$defs/specialistIds" }
      }
    }
  }
}
