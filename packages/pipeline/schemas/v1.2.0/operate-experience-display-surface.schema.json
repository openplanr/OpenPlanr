{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://openplanr.dev/schemas/v1.2.0/operate-experience-display-surface.schema.json",
	"x-openplanr-contract": {
		"id": "operate-experience-display-surface",
		"version": "1.0.0"
	},
	"title": "OpenPlanr browser-verifiable Operate display surface",
	"type": "object",
	"additionalProperties": false,
	"required": ["kind", "schemaVersion", "protocolVersion", "payload", "integrity"],
	"properties": {
		"kind": { "const": "operate-experience-display-surface" },
		"schemaVersion": { "const": "1.0.0" },
		"protocolVersion": { "const": "2.0.0" },
		"payload": {
			"allOf": [
				{ "$ref": "operate-experience-surface.schema.json" },
				{
					"properties": {
						"surface": { "enum": ["today", "inbox", "cycles", "cycle", "actions"] }
					},
					"required": ["surface"]
				}
			]
		},
		"integrity": { "$ref": "#/$defs/integrity" }
	},
	"$defs": {
		"integrity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["algorithm", "domain", "sourceViewHash", "contentHash"],
			"properties": {
				"algorithm": { "const": "sha-256-jcs" },
				"domain": { "const": "openplanr:operate-experience-display-surface:1.0.0" },
				"sourceViewHash": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/hash"
				},
				"contentHash": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/hash"
				}
			}
		}
	}
}
