{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.5.0/common.schema.json",
  "x-openplanr-contract": {
    "id": "protocol-common",
    "version": "1.5.0"
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": ".*\\S.*"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "skillId": {
      "type": "string",
      "pattern": "^planr-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "roleId": {
      "type": "string",
      "pattern": "^planr-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "ruleId": {
      "type": "string",
      "pattern": "^R(?:[1-9]|[1-9][0-9]+)$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "storyId": {
      "type": "string",
      "pattern": "^US-[0-9]{3}$"
    },
    "specId": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{3}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "repositoryKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "repositoryPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryKey",
        "path"
      ],
      "properties": {
        "repositoryKey": {
          "$ref": "#/$defs/repositoryKey"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sourceDigest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "roleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "roleVersion",
        "registryDigest"
      ],
      "properties": {
        "roleId": {
          "$ref": "#/$defs/roleId"
        },
        "roleVersion": {
          "$ref": "#/$defs/semver"
        },
        "registryDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "recovery",
        "path",
        "evidenceDigest"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z0-9_]+$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "$ref": "#/$defs/nonBlankText"
        },
        "recovery": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "protocolVersion",
        "documentVersion",
        "digestAlgorithm",
        "canonicalization",
        "documentDigest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "protocolVersion": {
          "const": "1.5.0"
        },
        "documentVersion": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "digestAlgorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "rfc8785"
        },
        "documentDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    }
  }
}
