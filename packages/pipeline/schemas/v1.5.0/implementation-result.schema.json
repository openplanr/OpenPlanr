{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.5.0/implementation-result.schema.json",
  "x-openplanr-contract": {
    "id": "implementation-result",
    "version": "1.5.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "task",
    "changed",
    "checks",
    "issues"
  ],
  "properties": {
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "partial",
            "blocked"
          ]
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/nonBlankText"
        }
      }
    },
    "task": {
      "oneOf": [
        {
          "title": "Planr task",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "planr-task"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/taskId"
            },
            "path": {
              "$ref": "common.schema.json#/$defs/relativePath"
            }
          }
        },
        {
          "title": "Direct request",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "direct-request"
            }
          }
        }
      ]
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "purpose"
        ],
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "purpose": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          }
        }
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "detail"
        ],
        "properties": {
          "command": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "detail": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          }
        }
      },
      "minItems": 0,
      "maxItems": 256
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem",
          "impact",
          "nextAction"
        ],
        "properties": {
          "problem": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "impact": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "nextAction": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          }
        }
      },
      "minItems": 0,
      "maxItems": 256
    }
  }
}
