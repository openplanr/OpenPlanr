{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.6.0/skill-completion-receipt.schema.json",
  "x-openplanr-contract": {
    "id": "skill-completion-receipt",
    "version": "1.6.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "skillId",
    "skillVersion",
    "sourceFormat",
    "completedAt",
    "summary",
    "selectedModules"
  ],
  "properties": {
    "kind": {
      "const": "skill-completion-receipt"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.6.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "skillId": {
      "$ref": "common.schema.json#/$defs/skillId"
    },
    "skillVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "sourceFormat": {
      "$ref": "common.schema.json#/$defs/sourceFormat"
    },
    "completedAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/nonBlankText"
    },
    "selectedModules": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/moduleRef"
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "description": "Optional reporting-only summary; never a Plan, Review, Ship, generation, or runtime prerequisite."
}
