{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.6.0/diagram-consumer-reference.schema.json",
  "x-openplanr-contract": {
    "id": "diagram-consumer-reference",
    "version": "1.6.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "referenceId",
    "diagramId",
    "consumer",
    "manifest",
    "source",
    "output",
    "accessibility"
  ],
  "properties": {
    "kind": {
      "const": "diagram-consumer-reference"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.6.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "referenceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "diagramId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "enum": [
            "specification",
            "documentation",
            "pdf"
          ]
        },
        "path": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "digest",
        "fidelity"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "mediaType": {
          "enum": [
            "image/svg+xml; charset=utf-8",
            "image/png"
          ]
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "fidelity": {
          "enum": [
            "editable",
            "render-only",
            "partial",
            "lossy",
            "unsupported"
          ]
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/nonBlankText"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/nonBlankText"
        }
      }
    }
  }
}
