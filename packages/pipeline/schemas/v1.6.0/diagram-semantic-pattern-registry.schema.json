{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.6.0/diagram-semantic-pattern-registry.schema.json",
  "x-openplanr-contract": {
    "id": "diagram-semantic-pattern-registry",
    "version": "1.6.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "patterns"
  ],
  "properties": {
    "kind": {
      "const": "diagram-semantic-pattern-registry"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.6.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patternId",
          "patternVersion",
          "triggers",
          "candidateGrammars",
          "selection"
        ],
        "properties": {
          "patternId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "patternVersion": {
            "const": "1.0.0"
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "candidateGrammars": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "selection": {
            "const": "rank-only"
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    }
  }
}
