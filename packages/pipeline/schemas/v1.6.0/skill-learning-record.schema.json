{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.6.0/skill-learning-record.schema.json",
  "x-openplanr-contract": {
    "id": "skill-learning-record",
    "version": "1.6.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "learningId",
    "skillId",
    "observedAt",
    "category",
    "note",
    "consentGranted",
    "consentRef"
  ],
  "properties": {
    "kind": {
      "const": "skill-learning-record"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.6.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "learningId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "skillId": {
      "$ref": "common.schema.json#/$defs/skillId"
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "category": {
      "enum": [
        "context",
        "review",
        "implementation",
        "diagnostic"
      ]
    },
    "note": {
      "$ref": "common.schema.json#/$defs/nonBlankText"
    },
    "consentGranted": {
      "type": "boolean"
    },
    "consentRef": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "consentGranted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "consentRef": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consentGranted": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "consentRef": {
            "type": "null"
          }
        }
      }
    }
  ]
}
