{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.6.0/diagram-review-binding.schema.json",
  "x-openplanr-contract": {
    "id": "diagram-review-binding",
    "version": "1.6.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "bindingId",
    "diagramId",
    "manifest",
    "artifact",
    "review"
  ],
  "properties": {
    "kind": {
      "const": "diagram-review-binding"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.6.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "diagramId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "envelopeDigest",
        "htmlDigest"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "envelopeDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "htmlDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewId",
            "reviewDigest",
            "pinIds"
          ],
          "properties": {
            "reviewId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reviewDigest": {
              "$ref": "common.schema.json#/$defs/digest"
            },
            "pinIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
