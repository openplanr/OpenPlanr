{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v2.0.0/operating-action-verification-plan.schema.json",
  "x-openplanr-contract": { "id": "operating-action-verification-plan", "version": "2.0.0" },
  "title": "OpenPlanr Operate 2.0 bounded action verification plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "verificationPlanId", "actionId", "scopeId", "domainId", "domainVersion", "metricId", "baseline", "target", "window", "method", "observationRequest", "evaluationRules", "revisitDecisionIds", "sourceArtifactId", "createdAt"],
  "properties": {
    "kind": { "const": "operating-action-verification-plan" }, "schemaVersion": { "const": "1.0.0" }, "protocolVersion": { "const": "2.0.0" }, "verificationPlanId": { "$ref": "#/$defs/planId" }, "actionId": { "$ref": "#/$defs/actionId" }, "scopeId": { "$ref": "#/$defs/id" }, "domainId": { "$ref": "#/$defs/id" }, "domainVersion": { "$ref": "#/$defs/version" }, "metricId": { "type": "string", "pattern": "^met_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" }, "baseline": { "type": "number" }, "target": { "type": "number" }, "window": { "$ref": "#/$defs/text" }, "method": { "$ref": "#/$defs/text" }, "observationRequest": { "$ref": "#/$defs/observationRequest" }, "evaluationRules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "revisitDecisionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/decisionId" } }, "sourceArtifactId": { "$ref": "#/$defs/artifactId" }, "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": { "actionId": { "type": "string", "pattern": "^act_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" }, "artifactId": { "type": "string", "pattern": "^art_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" }, "decisionId": { "type": "string", "pattern": "^dec_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" }, "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "observationRequest": { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "enum": ["future-observation", "future-analysis"] }, "reason": { "$ref": "#/$defs/text" } } }, "planId": { "type": "string", "pattern": "^vfy_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" }, "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[\\s\\S]*\\S[\\s\\S]*$" }, "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" } }
}
