{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v2.0.0/agent-runtime-manifest.schema.json",
  "x-openplanr-contract": { "id": "agent-runtime-manifest", "version": "2.0.0" },
  "title": "OpenPlanr Operate 2.0 agent runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "runtimeId", "runtimeVersion", "provenance", "implementation", "supportedContracts", "capabilitiesRequested", "limits", "health", "fallback"],
  "properties": {
    "kind": { "const": "agent-runtime-manifest" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "2.0.0" },
    "runtimeId": { "$ref": "#/$defs/identifier" },
    "runtimeVersion": { "$ref": "#/$defs/version" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "implementation": { "$ref": "#/$defs/implementation" },
    "supportedContracts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/supportedContract" } },
    "capabilitiesRequested": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^operate\\.[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$" } },
    "limits": { "$ref": "#/$defs/limits" },
    "health": { "$ref": "#/$defs/health" },
    "fallback": { "$ref": "#/$defs/fallback" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["packageName", "packageVersion", "integrity"],
      "properties": { "packageName": { "$ref": "#/$defs/identifier" }, "packageVersion": { "$ref": "#/$defs/version" }, "integrity": { "$ref": "#/$defs/digest" } }
    },
    "implementation": {
      "type": "object", "additionalProperties": false, "required": ["packageName", "packageVersion", "exportName", "availability"],
      "properties": {
        "packageName": { "$ref": "#/$defs/identifier" },
        "packageVersion": { "$ref": "#/$defs/version" },
        "exportName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*$" },
        "availability": { "enum": ["available", "unavailable"] }
      }
    },
    "supportedContract": {
      "type": "object", "additionalProperties": false, "required": ["schemaId", "schemaVersion"],
      "properties": { "schemaId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }, "schemaVersion": { "const": "2.0.0" } }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["maxConcurrentAssignments", "maxOutputBytes"],
      "properties": { "maxConcurrentAssignments": { "type": "integer", "minimum": 1 }, "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 262144 } }
    },
    "health": {
      "type": "object", "additionalProperties": false, "required": ["status", "checkedAt", "conformanceDigest"],
      "properties": { "status": { "const": "conformant" }, "checkedAt": { "type": "string", "format": "date-time" }, "conformanceDigest": { "$ref": "#/$defs/digest" } }
    },
    "fallback": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unavailable" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "runtimeId", "runtimeVersion"], "properties": { "kind": { "const": "runtime" }, "runtimeId": { "$ref": "#/$defs/identifier" }, "runtimeVersion": { "$ref": "#/$defs/version" } } }
      ]
    }
  }
}
