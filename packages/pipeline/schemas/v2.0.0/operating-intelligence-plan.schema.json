{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v2.0.0/operating-intelligence-plan.schema.json",
  "x-openplanr-contract": {
    "id": "operating-intelligence-plan",
    "version": "2.0.0"
  },
  "title": "OpenPlanr Operate 2.0 explainable intelligence plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "planId",
    "scopeId",
    "domainId",
    "domainVersion",
    "snapshotId",
    "deltaId",
    "selectedRoles",
    "omittedRoles",
    "challengerRequired",
    "scenarioRequest",
    "sourceArtifactId",
    "decisionOwnerActorId",
    "createdAt"
  ],
  "properties": {
    "kind": {
      "const": "operating-intelligence-plan"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "2.0.0"
    },
    "planId": {
      "$ref": "#/$defs/planId"
    },
    "scopeId": {
      "$ref": "#/$defs/id"
    },
    "domainId": {
      "$ref": "#/$defs/id"
    },
    "domainVersion": {
      "$ref": "#/$defs/version"
    },
    "snapshotId": {
      "$ref": "#/$defs/snapshotId"
    },
    "deltaId": {
      "$ref": "#/$defs/deltaId"
    },
    "selectedRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/selectedRole"
      }
    },
    "omittedRoles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/omittedRole"
      }
    },
    "challengerRequired": {
      "type": "boolean"
    },
    "scenarioRequest": {
      "$ref": "#/$defs/scenarioRequest"
    },
    "sourceArtifactId": {
      "$ref": "#/$defs/artifactId"
    },
    "decisionOwnerActorId": {
      "$ref": "#/$defs/id"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "challengerRequired": {
            "const": true
          }
        },
        "required": [
          "challengerRequired"
        ]
      },
      "then": {
        "properties": {
          "selectedRoles": {
            "contains": {
              "type": "object",
              "required": [
                "roleId",
                "roleKind",
                "roleVersion",
                "outputContract"
              ],
              "properties": {
                "roleKind": {
                  "const": "challenger"
                },
                "roleVersion": {
                  "const": "2.0.0"
                },
                "outputContract": {
                  "type": "object",
                  "required": [
                    "schemaId",
                    "schemaVersion"
                  ],
                  "properties": {
                    "schemaId": {
                      "const": "operating-challenger-review"
                    },
                    "schemaVersion": {
                      "const": "2.0.0"
                    }
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^art_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion"
      ],
      "properties": {
        "schemaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schemaVersion": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "deltaId": {
      "type": "string",
      "pattern": "^dlt_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "omittedRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "roleKind",
        "roleVersion",
        "reason"
      ],
      "properties": {
        "roleId": {
          "$ref": "#/$defs/id"
        },
        "roleVersion": {
          "$ref": "#/$defs/version"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^not-selected: .+"
        },
        "roleKind": {
          "enum": [
            "advisor",
            "challenger",
            "chair"
          ]
        }
      }
    },
    "planId": {
      "type": "string",
      "pattern": "^ipl_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "scenarioRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "reason"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "selectedRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "roleKind",
        "roleVersion",
        "inputArtifactIds",
        "outputContract",
        "dependsOnRoleIds",
        "reason"
      ],
      "properties": {
        "roleId": {
          "$ref": "#/$defs/id"
        },
        "roleVersion": {
          "$ref": "#/$defs/version"
        },
        "inputArtifactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactId"
          }
        },
        "outputContract": {
          "$ref": "#/$defs/contract"
        },
        "dependsOnRoleIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "roleKind": {
          "enum": [
            "advisor",
            "challenger",
            "chair"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "roleKind": { "const": "advisor" } }, "required": ["roleKind"] },
          "then": { "properties": { "outputContract": { "properties": { "schemaId": { "const": "operating-advisor-result" }, "schemaVersion": { "const": "2.0.0" } } } } }
        },
        {
          "if": { "properties": { "roleKind": { "const": "challenger" } }, "required": ["roleKind"] },
          "then": { "properties": { "outputContract": { "properties": { "schemaId": { "const": "operating-challenger-review" }, "schemaVersion": { "const": "2.0.0" } } } } }
        },
        {
          "if": { "properties": { "roleKind": { "const": "chair" } }, "required": ["roleKind"] },
          "then": { "properties": { "outputContract": { "properties": { "schemaId": { "const": "operating-decision-ledger" }, "schemaVersion": { "const": "2.0.0" } } } } }
        }
      ]
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snp_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^.*\\S.*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    }
  }
}
