{
  "name": "@openplanr/artifact",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "description": "Canonical OpenPlanr artifact review, sharing, and rendering runtime",
  "license": "MIT",
  "exports": {
    ".": "./lib/artifact/index.mjs",
    "./diagram": {
      "types": "./lib/artifact/diagram/index.d.mts",
      "import": "./lib/artifact/diagram/index.mjs"
    },
    "./diagram-authoring": {
      "types": "./lib/artifact/diagram/authoring/index.d.mts",
      "import": "./lib/artifact/diagram/authoring/index.mjs"
    },
    "./diagram-authoring-store": {
      "types": "./lib/artifact/diagram/authoring/store.d.mts",
      "import": "./lib/artifact/diagram/authoring/store.mjs"
    },
    "./diagram-authoring-export": {
      "types": "./lib/artifact/diagram/authoring/exports.d.mts",
      "import": "./lib/artifact/diagram/authoring/exports.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./lib/artifact/*",
    "./diagram-editor": {
      "types": "./lib/artifact/diagram/editor/index.d.mts",
      "import": "./lib/artifact/diagram/editor/index.mjs"
    },
    "./diagram-editor.css": "./lib/artifact/ui/diagram-editor.css",
    "./diagram-owner": {
      "types": "./lib/artifact/diagram/editor/local-owner.d.mts",
      "import": "./lib/artifact/diagram/editor/local-owner.mjs"
    },
    "./diagram-review-bundle/browser": {
      "types": "./lib/artifact/diagram/review-bundle-browser.d.mts",
      "import": "./lib/artifact/diagram/review-bundle-browser.mjs"
    },
    "./diagram-shared-review": {
      "types": "./lib/artifact/ui/diagram-shared-review.d.mts",
      "import": "./lib/artifact/ui/diagram-shared-review.mjs"
    },
    "./diagram-shared-review.css": "./lib/artifact/ui/diagram-shared-review.css",
    "./studio-shell": {
      "types": "./lib/artifact/ui/studio-shell.d.mts",
      "import": "./lib/artifact/ui/studio-shell.mjs"
    },
    "./studio-shell.css": "./lib/artifact/ui/studio-shell.css",
    "./review-outbox": {
      "types": "./lib/artifact/ui/review-outbox.d.mts",
      "import": "./lib/artifact/ui/review-outbox.mjs"
    },
    "./prototype-state": {
      "types": "./lib/artifact/ui/prototype-state.d.mts",
      "import": "./lib/artifact/ui/prototype-state.mjs"
    },
    "./resource-pack": {
      "types": "./lib/artifact/resource-pack.d.mts",
      "import": "./lib/artifact/resource-pack.mjs"
    },
    "./browser-sandbox": {
      "types": "./lib/artifact/browser-sandbox.d.mts",
      "import": "./lib/artifact/browser-sandbox.mjs"
    }
  },
  "files": [
    "lib/",
    "fixtures/",
    "gallery/",
    "references/",
    "templates/",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@openplanr/protocol": "0.10.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.2.18",
    "esbuild": "0.28.1",
    "pako": "2.1.0",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "radix-ui": "1.6.7"
  },
  "scripts": {
    "generate": "node scripts/generate-artifact-shell.mjs",
    "check": "node scripts/generate-artifact-shell.mjs --check",
    "generate:diagram": "node scripts/generate-diagram-assets.mjs",
    "check:diagram": "node scripts/generate-diagram-assets.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check:boundaries": "node --test tests/boundaries.test.mjs"
  },
  "openplanr": {
    "domain": "artifact",
    "sourceCutoff": "fa591a7e7157b47e10d33e4c30997925779c692e",
    "compatibilityProjection": "lib/artifact"
  }
}
