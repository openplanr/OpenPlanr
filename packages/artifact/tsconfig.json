{
  // Type-checks the TypeScript sources under lib/. scripts/typescript/compile-sources.mjs reads
  // this file and emits the .mjs and .d.mts beside each source; those outputs are gitignored.
  // allowJs types the imports of modules that are still JavaScript.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "newLine": "lf",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["lib/**/*.mts", "lib/**/*.tsx"],
  "exclude": ["lib/**/*.d.mts"]
}
