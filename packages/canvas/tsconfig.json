{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "newLine": "lf",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.mts"],
  "exclude": ["src/**/*.d.mts"]
}
