    {
      "id": "linear",
      "version": "1.0.0",
      "kind": "remote",
      "availability": "configured",
      "readOnly": true,
      "supportsIncremental": true,
      "evidenceKinds": ["linear"],
      "sensitivityCeiling": "confidential",
      "limits": { "maxItems": 500, "maxBytes": 5242880, "maxDurationMs": 60000 },
      "healthChecks": ["credential-available", "selected-teams-readable"]
    },
    {
      "id": "file-import",
      "version": "1.0.0",
      "kind": "import",
      "availability": "explicit",
      "readOnly": true,
      "supportsIncremental": false,
      "evidenceKinds": ["file-import"],
