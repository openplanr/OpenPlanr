{
  "kind": "operating-provider-registry",
  "schemaVersion": "1.0.0",
  "protocolVersion": "1.2.0",
  "providers": [
    {
      "id": "repository",
      "version": "1.0.0",
      "kind": "local",
      "availability": "builtin",
      "readOnly": true,
      "supportsIncremental": true,
      "evidenceKinds": ["repository"],
      "sensitivityCeiling": "restricted",
      "limits": { "maxItems": 1000, "maxBytes": 10485760, "maxDurationMs": 30000 },
      "healthChecks": ["project-root-valid", "realpath-contained"]
    },
    {
      "id": "planr",
      "version": "1.0.0",
      "kind": "local",
      "availability": "builtin",
      "readOnly": true,
      "supportsIncremental": true,
      "evidenceKinds": ["planr", "outcome"],
      "sensitivityCeiling": "restricted",
      "limits": { "maxItems": 2000, "maxBytes": 10485760, "maxDurationMs": 30000 },
      "healthChecks": ["planr-project-valid", "protocol-readable"]
    },
    {
      "id": "git",
      "version": "1.0.0",
      "kind": "local",
      "availability": "builtin",
      "readOnly": true,
      "supportsIncremental": true,
      "evidenceKinds": ["git"],
      "sensitivityCeiling": "confidential",
      "limits": { "maxItems": 500, "maxBytes": 5242880, "maxDurationMs": 30000 },
      "healthChecks": ["git-worktree", "read-only-command-set"]
    },
    {
      "id": "github",
      "version": "1.0.0",
      "kind": "remote",
      "availability": "configured",
