# Dependencies (any depth — fixtures run `npm ci` locally / in CI)
node_modules/

# Append-only pipeline run logs (SPEC-008)
*.run-manifest.jsonl
# …but seeded conformance fixtures ship their OWN .run-manifest.jsonl as test data (must be tracked)
!conformance/fixtures/**/.run-manifest.jsonl

# Transient sentinel from /ship Step 0 (never commit)
.claude/.snapshot-pending

# Transient /planr-pipeline:design artifacts (advisory lock + half-written output)
**/.design.lock
**/.finalized.tmp.*

# Local-only dev marketplace for testing this plugin from the working tree
# (the real distribution channel is the openplanr/marketplace repo).
.claude-plugin/marketplace.json

.DS_Store

# OpenPlanr's own dogfooding workspace — internal sprint planning, not part of plugin distribution
.planr/
!conformance/fixtures/dashboard-graph/.planr/
!conformance/fixtures/dashboard-graph/.planr/config.json
