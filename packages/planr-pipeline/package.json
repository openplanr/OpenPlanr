{
  "name": "planr-pipeline",
  "version": "0.38.0",
  "private": false,
  "type": "module",
  "description": "OpenPlanr complete PO, Design, DEV, QA, and delivery pipeline",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openplanr/planr-pipeline"
  },
  "bugs": {
    "url": "https://github.com/openplanr/planr-pipeline/issues"
  },
  "homepage": "https://github.com/openplanr/planr-pipeline#readme",
  "main": "./lib/pipeline/index.mjs",
  "exports": {
    ".": "./lib/pipeline/index.mjs",
    "./protocol": {
      "types": "./lib/protocol/index.d.ts",
      "import": "./lib/protocol/loader.mjs"
    },
    "./schemas/*": "./schemas/*",
    "./registry/*": "./registry/*"
  },
  "bin": {
    "planr-pipeline": "bin/planr-pipeline.mjs"
  },
  "files": [
    "adapters/",
    ".claude-plugin/",
    "agents/",
    "bin/",
    "commands/",
    "conformance/",
    "docs/adrs/ADR-005-artifact-review-sharing-security.md",
    "docs/adrs/ADR-006-operating-board-protocol.md",
    "docs/adrs/ADR-008-cli-owned-guided-interactions.md",
    "docs/adrs/ADR-009-intent-scoped-native-operating-cycles.md",
    "docs/adrs/ADR-010-operating-board-agentic-execution.md",
    "docs/adrs/ADR-011-agent-native-operating-board.md",
    "docs/adrs/ADR-012-board-sync-identity-fields.md",
    "docs/artifact-review.md",
    "docs/guided-operating-board.md",
    "docs/generated/",
    "docs/implementation/operating-board.md",
    "docs/runtime-guided-interactions.md",
    "docs/protocol/",
    "hooks/",
    "lib/",
    "procedures/",
    "registry/",
    "schemas/",
    "scripts/doctor.mjs",
    "scripts/generate-artifact-shell.mjs",
    "scripts/generate-operating-assets.mjs",
    "scripts/generate-guided-adapters.mjs",
    "scripts/guided-operate-canary.mjs",
    "scripts/operate-release-canary.mjs",
    "stacks/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "pako": "2.1.0",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "pixelmatch": "7.2.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0"
  },
  "scripts": {
    "test": "npm run test:schema && npm run test:orchestration && npm run test:docs && npm run test:design && npm run test:design-engine && npm run test:artifact && npm run test:dashboard && npm run check:operating-assets && npm run check:guided-adapters && npm run conformance:operate && npm run conformance:design && npm run conformance:design-loop && npm run conformance:artifact && npm run conformance:dashboard",
    "generate:artifact-shell": "node scripts/generate-artifact-shell.mjs",
    "check:artifact-shell": "node scripts/generate-artifact-shell.mjs --check",
    "generate:operating-assets": "node scripts/generate-operating-assets.mjs",
    "check:operating-assets": "node scripts/generate-operating-assets.mjs --check",
    "generate:guided-adapters": "node scripts/generate-guided-adapters.mjs",
    "check:guided-adapters": "node scripts/generate-guided-adapters.mjs --check",
    "test:guided-adapters": "node --test tests/orchestration/guided-runtime-adapters.test.mjs",
    "test:guided-acceptance": "node --test tests/ecosystem/guided-operate-acceptance.test.mjs",
    "test:artifact": "node scripts/run-test-group.mjs tests/artifact",
    "test:artifact:browser": "node --test tests/artifact/local-shell.test.mjs tests/artifact/review-interactions.test.mjs tests/artifact/share-ui.test.mjs tests/artifact/sandbox-hostile.test.mjs tests/artifact/design-board-integration.test.mjs",
    "test:artifact:contracts": "node --test tests/artifact/bundle.test.mjs tests/artifact/schemas-envelope.test.mjs",
    "test:artifact:share": "node --test tests/artifact/codec.test.mjs tests/artifact/crypto-share.test.mjs",
    "test:artifact:exports": "node --test tests/pipeline/artifact-exports.test.mjs",
    "test:artifact:packed": "node --test tests/pipeline/artifact-packed-install.test.mjs",
    "test:design-engine": "node scripts/run-test-group.mjs tests/design-engine tests/collab-review-board.test.mjs",
    "test:dashboard": "node scripts/run-test-group.mjs tests/dashboard",
    "test:docs": "node scripts/run-test-group.mjs tests/docs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:versions": "node scripts/doctor.mjs --versions-only",
    "ecosystem:conformance": "node scripts/ecosystem-conformance.mjs",
    "canary:artifact-release": "node scripts/artifact-release-canary.mjs",
    "canary:operate-release": "node scripts/operate-release-canary.mjs",
    "canary:guided-operate": "node scripts/guided-operate-canary.mjs --fixtures",
    "conformance:native-dispatch": "node conformance/runner.mjs --runtime claude-code --verify-ship --dir conformance/fixtures/native-dispatch-nd1-parallel && node conformance/runner.mjs --runtime claude-code --verify-ship --dir conformance/fixtures/native-dispatch-nd2-advisory-locklist && node conformance/runner.mjs --runtime claude-code --verify-ship --dir conformance/fixtures/native-dispatch-nd3-dependson && node conformance/runner.mjs --runtime claude-code --verify-ship --dir conformance/fixtures/native-dispatch-nd4-per-task",
    "conformance:check": "npm run conformance:native-dispatch && npm run conformance:operate && npm run conformance:design && npm run conformance:design-loop && npm run conformance:artifact && npm run conformance:dashboard",
    "conformance:operate": "node conformance/verify-operating-board.mjs && node conformance/verify-operating-dashboard.mjs && npm run conformance:operate-v1-3 && npm run conformance:operate-v1-4",
    "conformance:operate-v1-3": "node conformance/verify-operating-board-v1_3.mjs && node conformance/verify-operating-mandate-vocabulary.mjs && node conformance/verify-operating-records-migration.mjs && node conformance/verify-operating-board-amendment.mjs",
    "conformance:operate-v1-4": "node conformance/verify-operating-board-v1_4.mjs",
    "conformance:artifact": "npm run conformance:artifact-review",
    "conformance:artifact-review": "node conformance/verify-artifact-review.mjs",
    "conformance:design-loop": "node conformance/verify-design-loop.mjs",
    "conformance:dashboard": "node conformance/verify-dashboard.mjs",
    "test:schema": "node scripts/run-test-group.mjs tests/schema",
    "test:orchestration": "node scripts/run-test-group.mjs tests/orchestration tests/ecosystem tests/pipeline",
    "test:guided-contracts": "node --test tests/schema/guided-interaction-schemas.test.mjs tests/orchestration/guided-interaction-contracts.test.mjs",
    "test:design": "node scripts/run-test-group.mjs tests/design",
    "conformance:design": "node conformance/verify-design-assets.mjs"
  }
}
