{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-cycle-manifest.schema.json",
  "title": "OpenPlanr operating cycle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "id", "state", "depth", "focus", "inputDigest", "enabledRoles", "enabledProviders", "createdAt", "updatedAt", "producer"],
  "properties": {
    "kind": { "const": "operating-cycle-manifest" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "id": { "type": "string", "pattern": "^CYCLE-[0-9]{3,}$" },
    "state": { "type": "string", "enum": ["preparing", "collecting", "advising", "consolidating", "reviewable", "closed", "blocked", "failed", "cancelled"] },
    "health": { "type": "string", "enum": ["normal", "quiet", "partial", "blocked"] },
    "depth": { "type": "string", "enum": ["standard", "deep", "review-only"] },
    "focus": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["strategy", "product", "growth", "operations", "technology", "all"] } },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "enabledRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "enabledProviders": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "runtime"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
