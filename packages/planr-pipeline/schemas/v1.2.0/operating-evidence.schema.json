{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-evidence.schema.json",
  "title": "OpenPlanr operating evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "cycleId", "fingerprint", "collectedAt", "truncated", "items", "sources", "warnings"],
  "properties": {
    "kind": { "const": "operating-evidence" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "cycleId": { "type": "string", "pattern": "^CYCLE-[0-9]{3,}$" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "collectedAt": { "type": "string", "format": "date-time" },
    "truncated": { "type": "boolean" },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "location", "digest", "collectedAt", "observedFrom", "observedTo", "freshness", "sensitivity", "claimTypes"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" },
          "source": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "location": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "collectedAt": { "type": "string", "format": "date-time" },
          "observedFrom": { "type": ["string", "null"], "format": "date-time" },
          "observedTo": { "type": ["string", "null"], "format": "date-time" },
          "freshness": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
          "sensitivity": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
          "claimTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "canonicalRemote", "revision", "configuredBranch", "dirtyFingerprint"],
            "properties": {
              "componentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "canonicalRemote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?:https://|ssh://|git@)[^\\s?#]+$"
              },
              "revision": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
              "configuredBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
              "dirtyFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          },
          "metric": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "query", "observedFrom", "observedTo"],
            "properties": {
              "identity": { "type": "string", "minLength": 1 },
              "query": { "type": "string", "minLength": 1 },
              "observedFrom": { "type": "string", "format": "date-time" },
              "observedTo": { "type": "string", "format": "date-time" }
            }
          },
          "summary": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "baselineFingerprint",
        "changedEvidenceRefs",
        "requiredEvidenceRefs",
        "selectedEvidenceRefs",
        "removedEvidenceRefs"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["baseline", "standard", "deep"] },
        "baselineFingerprint": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "changedEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" }
        },
        "requiredEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" }
        },
        "selectedEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" }
        },
        "removedEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" }
        }
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fingerprint", "status", "itemCount", "byteCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "status": { "type": "string", "enum": ["collected", "unchanged", "partial", "unavailable", "failed"] },
          "itemCount": { "type": "integer", "minimum": 0 },
          "byteCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
