{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-provider-registry.schema.json",
  "title": "OpenPlanr operating evidence provider registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "providers"],
  "properties": {
    "kind": { "const": "operating-provider-registry" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "kind", "availability", "readOnly", "supportsIncremental", "evidenceKinds", "sensitivityCeiling", "limits", "healthChecks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "kind": { "type": "string", "enum": ["local", "remote", "import"] },
          "availability": { "type": "string", "enum": ["builtin", "configured", "explicit"] },
          "readOnly": { "const": true },
          "supportsIncremental": { "type": "boolean" },
          "evidenceKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "sensitivityCeiling": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxItems", "maxBytes", "maxDurationMs"],
            "properties": {
              "maxItems": { "type": "integer", "minimum": 1, "maximum": 10000 },
              "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 },
              "maxDurationMs": { "type": "integer", "minimum": 100, "maximum": 300000 }
            }
          },
          "healthChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
