{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/ecosystem-saga.schema.json",
  "title": "OpenPlanr multi-repository release saga",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "id", "subject", "state", "createdAt", "updatedAt", "participants", "steps"],
  "properties": {
    "kind": { "const": "ecosystem-saga" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "id": { "type": "string", "pattern": "^SAGA-[A-Za-z0-9._-]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["planned", "in-progress", "blocked", "failed", "completed", "compensated"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "repository": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["contract-owner", "behavior-owner", "adapter", "publisher"] }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "participantId", "action", "dependsOn", "idempotencyKey", "status", "attempts", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "participantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "action": { "type": "string", "minLength": 1 },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
          "idempotencyKey": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pending", "ready", "in-progress", "completed", "failed", "compensated", "skipped"] },
          "attempts": { "type": "integer", "minimum": 0, "maximum": 20 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "error": { "type": "string" },
          "completedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
