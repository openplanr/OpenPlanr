{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-config.schema.json",
  "title": "OpenPlanr operating configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "profile", "decisionOwner", "cadence", "planningEngine", "enabledRoles", "enabledProviders", "caps", "budgets"],
  "properties": {
    "kind": { "const": "operating-config" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "profile": { "type": "string", "enum": ["saas", "product", "engineering", "custom"] },
    "decisionOwner": { "type": "string", "minLength": 1, "maxLength": 120 },
    "cadence": { "type": "string", "enum": ["manual", "weekly", "monthly"] },
    "planningEngine": { "type": "string", "enum": ["openplanr", "pipeline-po"] },
    "enabledRoles": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "enum": ["strategy-finance", "technology-risk", "product-activation", "growth-market", "operations-customer", "chair"] } },
    "enabledProviders": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfacedFindings", "newSpecs", "openDecisions", "agentArtifacts"],
      "properties": {
        "surfacedFindings": { "type": "integer", "minimum": 1, "maximum": 50 },
        "newSpecs": { "type": "integer", "minimum": 0, "maximum": 10 },
        "openDecisions": { "type": "integer", "minimum": 0, "maximum": 20 },
        "agentArtifacts": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFiles", "maxItems", "maxBytes", "maxDurationMs"],
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 },
        "maxDurationMs": { "type": "integer", "minimum": 100, "maximum": 600000 }
      }
    }
  }
}
