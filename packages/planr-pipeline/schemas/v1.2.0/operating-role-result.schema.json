{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-role-result.schema.json",
  "title": "OpenPlanr operating advisor result",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "cycleId", "roleId", "inputDigest", "resultDigest", "outcome", "proposals", "gaps", "conflicts", "producer"],
  "properties": {
    "kind": { "const": "operating-role-result" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "cycleId": { "type": "string", "pattern": "^CYCLE-[0-9]{3,}$" },
    "roleId": { "type": "string", "enum": ["strategy-finance", "technology-risk", "product-activation", "growth-market", "operations-customer", "chair"] },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outcome": { "type": "string", "enum": ["proposals", "quiet", "failed"] },
    "proposals": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposalKey", "type", "title", "problem", "proposal", "impact", "confidence", "ease", "severity", "evidenceRefs"],
        "properties": {
          "proposalKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "type": { "type": "string", "enum": ["finding", "decision", "data-gap", "merge", "sequence"] },
          "title": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "proposal": { "type": "string", "minLength": 1 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "ease": { "type": "integer", "minimum": 1, "maximum": 5 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" } },
          "dependsOnProposalKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          },
          "conflictsWithProposalKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          },
          "sequenceProposalKeys": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "runtime", "capability"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "enum": ["analysis-standard", "analysis-high"] }
      }
    }
  }
}
