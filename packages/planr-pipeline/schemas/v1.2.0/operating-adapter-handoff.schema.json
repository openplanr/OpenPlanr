{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-adapter-handoff.schema.json",
  "title": "OpenPlanr Protocol v1.2 operating adapter handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "phase",
    "state",
    "binding",
    "roles",
    "next",
    "recovery"
  ],
  "properties": {
    "kind": { "const": "operating-adapter-handoff" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "phase": { "enum": ["advisors", "chair"] },
    "state": {
      "enum": [
        "prepare-required",
        "record-required",
        "finalize-required",
        "continue-required",
        "cancelled"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycleId",
        "evidenceDigest",
        "runtime",
        "idempotencyKey",
        "lease",
        "expiresAt"
      ],
      "properties": {
        "cycleId": {
          "type": "string",
          "pattern": "^CYCLE-[A-Za-z0-9._-]{1,120}$"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "lease": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{32,128}$"
            }
          ]
        },
        "expiresAt": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleId", "status", "inputDigest"],
        "properties": {
          "roleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "enum": ["awaiting-prepare", "pending", "recorded"]
          },
          "inputDigest": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            ]
          }
        }
      }
    },
    "next": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/machineAction" }
    },
    "recovery": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/machineAction" }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_./:@%+=,-]+$"
      }
    },
    "machineAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "effect", "argv"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,127}$"
        },
        "action": {
          "enum": [
            "adapter.prepare",
            "adapter.record",
            "adapter.finalize",
            "adapter.resume",
            "adapter.cancel",
            "run.continue"
          ]
        },
        "effect": {
          "enum": ["read-only", "machine-local-write", "project-write"]
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "argv": { "$ref": "#/$defs/argv" },
        "dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "rolePackPointer", "isolation"],
          "properties": {
            "source": { "const": "adapter.prepare-result" },
            "rolePackPointer": {
              "type": "string",
              "pattern": "^/data/rolePacks/[a-z][a-z0-9-]{0,63}$"
            },
            "isolation": { "const": "enforced-empty-tools" }
          }
        },
        "stdin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mediaType",
            "encoding",
            "maxBytes",
            "schema",
            "schemaSource",
            "schemaPointer"
          ],
          "properties": {
            "kind": { "const": "stdin-json" },
            "mediaType": { "const": "application/json" },
            "encoding": { "const": "utf-8" },
            "maxBytes": { "const": 32768 },
            "schema": {
              "const": "https://openplanr.dev/schemas/v1.2.0/operating-advisor-response.schema.json"
            },
            "schemaSource": { "const": "adapter.prepare-result" },
            "schemaPointer": {
              "type": "string",
              "pattern": "^/data/rolePacks/[a-z][a-z0-9-]{0,63}/roleBrief/output/jsonSchema$"
            }
          }
        }
      }
    }
  }
}
