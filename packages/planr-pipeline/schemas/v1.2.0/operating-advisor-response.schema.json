{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-advisor-response.schema.json",
  "title": "OpenPlanr compact native operating advisor response",
  "description": "The bounded response a native runtime returns to the OpenPlanr engine. The engine supplies cycle, role, producer, and digest metadata when it creates the canonical operating-role-result.",
  "type": "object",
  "additionalProperties": false,
  "examples": [
    {
      "outcome": "quiet",
      "proposals": [],
      "gaps": [],
      "conflicts": []
    }
  ],
  "required": ["outcome", "proposals", "gaps", "conflicts"],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["proposals", "quiet"]
    },
    "proposals": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["proposalKey", "type", "title", "problem", "proposal", "impact", "confidence", "ease", "severity", "evidenceRefs"],
        "properties": {
          "proposalKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "type": { "type": "string", "enum": ["finding", "decision", "data-gap", "merge", "sequence"] },
          "title": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "proposal": { "type": "string", "minLength": 1 },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "ease": { "type": "integer", "minimum": 1, "maximum": 5 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" }
          },
          "dependsOnProposalKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          },
          "conflictsWithProposalKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          },
          "sequenceProposalKeys": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "oneOf": [
    {
      "required": ["outcome", "proposals"],
      "properties": {
        "outcome": { "const": "quiet" },
        "proposals": { "maxItems": 0 }
      }
    },
    {
      "required": ["outcome", "proposals"],
      "properties": {
        "outcome": { "const": "proposals" },
        "proposals": { "minItems": 1 }
      }
    }
  ]
}
