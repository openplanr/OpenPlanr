{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.2.0/operating-transaction-journal.schema.json",
  "title": "OpenPlanr operating write-ahead transaction journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "transactionId", "state", "eventHead", "previewDigest", "createdAt", "updatedAt", "writes"],
  "properties": {
    "kind": { "const": "operating-transaction-journal" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.2.0" },
    "transactionId": { "type": "string", "pattern": "^TXN-[A-Za-z0-9._-]+$" },
    "state": { "type": "string", "enum": ["prepared", "staged-fsynced", "promoted", "committed", "rolled-back", "failed"] },
    "eventHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "previewDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "writes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "beforeDigest", "afterDigest", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "enum": ["create", "replace", "append"] },
          "beforeDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
          "afterDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "mode": { "type": "string", "pattern": "^0[0-7]{3}$" }
        }
      }
    },
    "failureCode": { "type": "string", "pattern": "^E_[A-Z0-9_]+$" }
  }
}
