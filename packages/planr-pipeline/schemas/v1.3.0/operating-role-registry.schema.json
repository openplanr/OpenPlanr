{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.3.0/operating-role-registry.schema.json",
  "title": "OpenPlanr Protocol v1.3 operating advisor registry",
  "description": "The v1.3 operating advisor registry. Role requirements are expressed as an investigation mandate — what the lens must examine and what constitutes sufficient grounding — in the vocabulary a citation can satisfy (repository path, git revision, or planr artifact). Claim-type matching (minimumEvidence) and the pack/mission dispatchMode selector are retired: a single mandate is now the only unit of dispatch and evidence is an output resolved from returned citations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "roles"],
  "properties": {
    "kind": { "const": "operating-role-registry" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.3.0" },
    "roles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "displayLabel", "mandate", "forbiddenRecommendationCategories", "permittedEvidenceKinds", "sensitivityCeiling", "capabilityTier", "inputSchema", "outputSchema", "readOnly", "writeBoundary", "allowedProposalTypes", "budgets", "requiredEvidenceFields", "investigationMandate", "failureBehavior"],
        "properties": {
          "id": { "type": "string", "enum": ["strategy-finance", "technology-risk", "product-activation", "growth-market", "operations-customer", "chair"] },
          "order": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "displayLabel": { "type": "string", "minLength": 1 },
          "mandate": { "type": "string", "minLength": 20 },
          "forbiddenRecommendationCategories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "permittedEvidenceKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "sensitivityCeiling": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
          "capabilityTier": { "type": "string", "enum": ["analysis-standard", "analysis-high"] },
          "inputSchema": { "type": "string", "pattern": "^[a-z][a-z0-9-]+@1\\.2\\.0$" },
          "outputSchema": { "const": "operating-role-result@1.2.0" },
          "adapterResponseSchema": { "const": "operating-advisor-response@1.2.0" },
          "readOnly": { "const": true },
          "writeBoundary": { "const": "none" },
          "allowedProposalTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "budgets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxInputBytes", "maxOutputBytes", "maxProposals"],
            "properties": {
              "maxInputBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
              "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 131072 },
              "maxProposals": { "type": "integer", "minimum": 1, "maximum": 20 }
            }
          },
          "requiredEvidenceFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "investigationMandate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["examine", "sufficientGrounding"],
            "properties": {
              "examine": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 512 }
              },
              "sufficientGrounding": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          },
          "failureBehavior": { "type": "string", "enum": ["standard-partial-deep-blocked", "critical-route-blocked", "cycle-blocked"] }
        }
      }
    }
  }
}
