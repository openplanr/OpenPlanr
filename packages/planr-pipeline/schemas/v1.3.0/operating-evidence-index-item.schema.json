{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.3.0/operating-evidence-index-item.schema.json",
  "title": "OpenPlanr Protocol v1.3 operating evidence index item",
  "description": "A single candidate evidence pointer in a mission packet: path or revision reference, content hash, source, classification, freshness, sensitivity, and detected signals. The item carries no file body; the agent reads the referenced content on demand within its declared roots.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "contentHash",
    "classification",
    "freshness",
    "sensitivity",
    "signals"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^EVX-[A-Za-z0-9._-]+$" },
    "path": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": {
      "type": "string",
      "enum": ["repository", "planr", "git", "github", "linear", "file-import"]
    },
    "classification": { "type": "string", "minLength": 1, "maxLength": 128 },
    "freshness": { "type": "string", "enum": ["fresh", "stale", "unknown"] },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  },
  "oneOf": [
    {
      "title": "path-referenced index item",
      "allOf": [
        { "required": ["path"] },
        { "not": { "required": ["revision"] } }
      ]
    },
    {
      "title": "revision-referenced index item",
      "allOf": [
        { "required": ["revision"] },
        { "not": { "required": ["path"] } }
      ]
    }
  ]
}
