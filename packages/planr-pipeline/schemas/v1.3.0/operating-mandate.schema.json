{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.3.0/operating-mandate.schema.json",
  "title": "OpenPlanr Protocol v1.3 operating mandate",
  "description": "The bounded instruction a role's lens receives as the unit of dispatch, replacing role packs and mission packets. It carries the lens question and mandate prose, an investigation mandate (what to examine and what constitutes sufficient grounding), declared read boundaries (roots, sensitivity ceiling, forbidden paths), the required response schema, and the citation requirement. It deliberately carries NO evidence body and NO evidence index: the agent investigates with the host's own read tools, and evidence becomes an OUTPUT the engine resolves from the returned citations. additionalProperties:false so no evidence field can be added silently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "roleId",
    "lensQuestion",
    "mandate",
    "investigationMandate",
    "boundaries",
    "responseSchema",
    "citationRequirement",
    "mandateDigest"
  ],
  "properties": {
    "kind": { "const": "operating-mandate" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.3.0" },
    "roleId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "lensQuestion": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "mandate": { "type": "string", "minLength": 20 },
    "investigationMandate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examine", "sufficientGrounding"],
      "properties": {
        "examine": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "sufficientGrounding": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "sensitivityCeiling", "forbiddenPaths"],
      "properties": {
        "roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._][A-Za-z0-9._/-]*$"
          }
        },
        "sensitivityCeiling": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "forbiddenPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._][A-Za-z0-9._/-]*$"
          }
        }
      }
    },
    "responseSchema": { "const": "operating-advisor-response@1.3.0" },
    "citationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["everyClaimCited", "citationShape", "description"],
      "properties": {
        "everyClaimCited": { "const": true },
        "citationShape": { "const": "operating-citation@1.3.0" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "mandateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
