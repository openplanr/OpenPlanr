            "warnings": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "errorCode": {
              "type": "string",
              "pattern": "^E_[A-Z0-9_]+$"
            },
            "recoveredTransactions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^TXN-[A-Za-z0-9._-]+$"
              }
            }
          }
        }
      }
