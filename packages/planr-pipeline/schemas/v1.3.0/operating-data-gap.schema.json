{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.3.0/operating-data-gap.schema.json",
  "title": "OpenPlanr Protocol v1.3 operating data gap",
  "description": "Identical to the v1.2 data gap, plus a category enum that admits 'unresolvable-citation' and resolved citation references. The id accepts digest-derived identifiers so the citation resolver can open a gap keyed by content digest without a central counter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "id", "cycleId", "question", "reason", "unblocks", "status", "owner", "evidenceRefs", "createdAt", "updatedAt"],
  "properties": {
    "kind": { "const": "operating-data-gap" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.3.0" },
    "id": { "type": "string", "pattern": "^GAP-[A-Za-z0-9._-]+$" },
    "cycleId": { "type": "string", "pattern": "^CYCLE-[0-9]{3,}$" },
    "category": {
      "type": "string",
      "enum": [
        "missing-evidence",
        "insufficient-freshness",
        "conflicting-evidence",
        "unavailable-provider",
        "unresolvable-citation"
      ]
    },
    "question": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "unblocks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:(?:FND|DEC|SPEC)-[0-9]{3,}|GAP-[A-Za-z0-9._-]+)$" } },
    "affectedRoles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["strategy-finance", "technology-risk", "product-activation", "growth-market", "operations-customer", "chair"]
      }
    },
    "status": { "type": "string", "enum": ["open", "answered", "verified", "closed", "superseded"] },
    "owner": { "type": "string", "minLength": 1 },
    "answer": { "type": "string" },
    "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" } },
    "citations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "snapshotDigest"],
        "properties": {
          "citationKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 128 },
          "evidenceId": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" },
          "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
