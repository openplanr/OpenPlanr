{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.3.0/operating-cadence-status.schema.json",
  "title": "OpenPlanr Protocol v1.3 operating cadence status",
  "description": "The cadence contract surfaced in cycle status. 'manual' runs only on request and has no next due date. 'weekly' and 'monthly' compute and surface the next due date. Scheduled execution never accepts findings, applies routes, invokes PLAN, or invokes SHIP.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "cadence", "lastRunAt", "nextDueAt"],
  "properties": {
    "kind": { "const": "operating-cadence-status" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.3.0" },
    "cadence": { "type": "string", "enum": ["manual", "weekly", "monthly"] },
    "lastRunAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "nextDueAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    }
  },
  "oneOf": [
    {
      "title": "manual cadence has no next due date",
      "required": ["cadence"],
      "properties": {
        "cadence": { "const": "manual" },
        "nextDueAt": { "type": "null" }
      }
    },
    {
      "title": "scheduled cadence computes a next due date",
      "required": ["cadence"],
      "properties": {
        "cadence": { "enum": ["weekly", "monthly"] },
        "nextDueAt": { "type": "string", "format": "date-time" }
      }
    }
  ]
}
