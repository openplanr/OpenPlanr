{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.3.0/operating-route-plan.schema.json",
  "title": "OpenPlanr Protocol v1.3 operating route plan",
  "description": "Identical to the v1.2 route plan, plus the 'create-quick-task' action kind so bounded, small work can route to the existing quick-task delivery surface and the 'create-epic' action kind so a group of related accepted findings can route to epic creation (the anchor finding is carried in findingId; the full member-finding list lives in the generated epic markdown). Both are additive; nothing may invoke PLAN or SHIP; R1 remains mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "id", "cycleId", "inputDigest", "routeDigest", "previewDigest", "workspaceDigest", "evidenceDigest", "providerDigest", "destinationDigest", "eventHead", "state", "actions", "createdAt"],
  "properties": {
    "kind": { "const": "operating-route-plan" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.3.0" },
    "id": { "type": "string", "pattern": "^ACT-[0-9]{3,}$" },
    "cycleId": { "type": "string", "pattern": "^CYCLE-[0-9]{3,}$" },
    "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "routeDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "previewDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workspaceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "providerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "destinationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "eventHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "state": { "type": "string", "enum": ["proposed", "accepted", "prepared", "applied", "failed", "rolled_back"] },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "findingId", "lane", "owner", "kind", "dependsOn", "evidenceRefs", "reversible", "requiresConfirmation"],
        "properties": {
          "id": { "type": "string", "pattern": "^ACT-[0-9]{3,}$" },
          "findingId": { "type": "string", "pattern": "^FND-[0-9]{3,}$" },
          "lane": { "type": "string", "enum": ["DEV", "OWNER", "AGENT"] },
          "owner": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["create-spec", "create-instrumentation-spec", "create-decision", "create-cycle-artifact", "create-quick-task", "create-epic"] },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^ACT-[0-9]{3,}$" } },
          "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-[A-Za-z0-9._-]+$" } },
          "reversible": { "const": true },
          "requiresConfirmation": { "const": true },
          "targetPath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "appliedAt": { "type": ["string", "null"], "format": "date-time" },
    "rolledBackAt": { "type": ["string", "null"], "format": "date-time" },
    "failure": { "type": "string", "minLength": 1 }
  }
}
