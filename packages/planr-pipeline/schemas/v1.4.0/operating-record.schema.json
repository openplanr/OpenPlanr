{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.4.0/operating-record.schema.json",
  "title": "OpenPlanr Protocol v1.4 agent-native operating record",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "digest", "recordType", "createdAt", "correlationId", "contentDigest", "content"],
  "properties": {
    "kind": { "const": "operating-record" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.4.0" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "recordType": { "const": "advisor-report" },
    "createdAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "content": { "$ref": "operating-advisor-response.schema.json" }
  }
}
