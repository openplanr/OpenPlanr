{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.4.0/operating-citation.schema.json",
  "title": "OpenPlanr Protocol v1.4 operating citation",
  "description": "A runtime-authored citation resolved by OpenPlanr before a material claim or action is persisted. Local and connected research use the same shape; external sources are permitted only when the cycle explicitly consented to connected research.",
  "oneOf": [
    { "$ref": "#/$defs/repository" },
    { "$ref": "#/$defs/git" },
    { "$ref": "#/$defs/planr" },
    { "$ref": "#/$defs/external" }
  ],
  "$defs": {
    "revision": { "type": "string", "pattern": "^[A-Fa-f0-9]{7,64}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "startLine", "endLine", "revision"],
      "properties": {
        "kind": { "const": "repository" },
        "componentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "revision": { "$ref": "#/$defs/revision" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision"],
      "properties": {
        "kind": { "const": "git" },
        "componentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "revision": { "$ref": "#/$defs/revision" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
      }
    },
    "planr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifactId", "path", "digest"],
      "properties": {
        "kind": { "const": "planr" },
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url", "title", "retrievedAt", "contentDigest"],
      "properties": {
        "kind": { "const": "external" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 256 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
