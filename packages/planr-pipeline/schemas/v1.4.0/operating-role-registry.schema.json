{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.4.0/operating-role-registry.schema.json",
  "title": "OpenPlanr Protocol v1.4 agent-native operating role registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "roles"],
  "properties": {
    "kind": { "const": "operating-role-registry" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.4.0" },
    "roles": {
      "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "order", "displayLabel", "mandate", "forbiddenRecommendationCategories", "permittedEvidenceKinds", "sensitivityCeiling", "capabilityTier", "responseSchema", "readOnly", "writeBoundary", "allowedRouteKinds", "budgets", "investigationMandate", "failureBehavior"],
        "properties": {
          "id": { "type": "string", "enum": ["strategy-finance", "technology-risk", "product-activation", "growth-market", "operations-customer", "chair"] },
          "order": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "displayLabel": { "type": "string", "enum": ["CEO", "CTO", "CPO", "CMO", "COO", "Chair"] },
          "mandate": { "type": "string", "minLength": 20 },
          "forbiddenRecommendationCategories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "permittedEvidenceKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "sensitivityCeiling": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
          "capabilityTier": { "type": "string", "enum": ["analysis-standard", "analysis-high"] },
          "responseSchema": { "const": "operating-advisor-response@1.4.0" },
          "readOnly": { "const": true },
          "writeBoundary": { "const": "governed-output-only" },
          "allowedRouteKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["quick-task", "spec", "epic", "decision", "agent-artifact", "experiment", "metric"] } },
          "budgets": {
            "type": "object", "additionalProperties": false,
            "required": ["maxOutputBytes", "maxActions"],
            "properties": { "maxOutputBytes": { "type": "integer", "minimum": 16384, "maximum": 524288 }, "maxActions": { "type": "integer", "minimum": 1, "maximum": 20 } }
          },
          "investigationMandate": {
            "type": "object", "additionalProperties": false,
            "required": ["examine", "sufficientGrounding"],
            "properties": {
              "examine": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
              "sufficientGrounding": { "type": "string", "minLength": 1, "maxLength": 2048 }
            }
          },
          "failureBehavior": { "type": "string", "enum": ["standard-partial-deep-blocked", "critical-route-blocked", "cycle-blocked"] }
        }
      }
    }
  }
}
