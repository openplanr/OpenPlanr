{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.7.0/skill-module-registry.schema.json",
  "x-openplanr-contract": {
    "id": "skill-module-registry",
    "version": "1.7.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "modules"
  ],
  "properties": {
    "kind": {
      "const": "skill-module-registry"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.7.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "moduleVersion",
          "moduleKind",
          "description",
          "authorityCeiling",
          "source",
          "appliesWhen",
          "dependsOn",
          "references"
        ],
        "properties": {
          "moduleId": {
            "$ref": "common.schema.json#/$defs/moduleId"
          },
          "moduleVersion": {
            "$ref": "common.schema.json#/$defs/semver"
          },
          "moduleKind": {
            "enum": [
              "lifecycle",
              "context",
              "review",
              "implementation",
              "shared"
            ]
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "authorityCeiling": {
            "$ref": "common.schema.json#/$defs/authorityCeiling"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          },
          "appliesWhen": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/moduleRef"
            },
            "minItems": 0,
            "maxItems": 64
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/moduleRef"
            },
            "minItems": 0,
            "maxItems": 64
          }
        }
      },
      "minItems": 0,
      "maxItems": 512
    }
  }
}
