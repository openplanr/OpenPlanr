{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.7.0/skill-consent-record.schema.json",
  "x-openplanr-contract": {
    "id": "skill-consent-record",
    "version": "1.7.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "consentId",
    "skillId",
    "subject",
    "decision",
    "recordedAt",
    "confirmation"
  ],
  "properties": {
    "kind": {
      "const": "skill-consent-record"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.7.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "consentId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "skillId": {
      "$ref": "common.schema.json#/$defs/skillId"
    },
    "subject": {
      "enum": [
        "learning",
        "telemetry",
        "external-data"
      ]
    },
    "decision": {
      "enum": [
        "granted",
        "declined",
        "withdrawn"
      ]
    },
    "recordedAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "confirmation": {
      "$ref": "https://openplanr.dev/schemas/v1.2.0/guided-confirmation.schema.json"
    }
  }
}
