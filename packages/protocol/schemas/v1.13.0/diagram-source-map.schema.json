{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.13.0/diagram-source-map.schema.json",
  "x-openplanr-contract": {
    "id": "diagram-source-map",
    "version": "1.13.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "diagram-source-map"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.13.0"
    },
    "diagramId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "semanticDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceByteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "encoding": {
      "const": "utf-8"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "certificationVersion": {
      "const": "flowchart-copy-v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceId": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            ]
          },
          "elementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "range": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "startByte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1048576
                  },
                  "endByte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1048576
                  }
                },
                "required": [
                  "startByte",
                  "endByte"
                ]
              }
            ]
          },
          "construct": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "confidence": {
            "enum": [
              "exact",
              "ambiguous"
            ]
          },
          "losses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 0,
            "maxItems": 64
          }
        },
        "required": [
          "sourceId",
          "elementIds",
          "range",
          "construct",
          "confidence",
          "losses"
        ]
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "diagramId",
    "semanticDigest",
    "sourceDigest",
    "sourceByteLength",
    "encoding",
    "parser",
    "certificationVersion",
    "entries"
  ]
}
