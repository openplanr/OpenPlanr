{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.13.0/diagram-fidelity-report.schema.json",
  "x-openplanr-contract": {
    "id": "diagram-fidelity-report",
    "version": "1.13.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "diagram-fidelity-report"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.13.0"
    },
    "diagramId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundleDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "semanticDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "presentationDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "bundleDigest",
        "semanticDigest",
        "presentationDigest"
      ]
    },
    "sourceDigest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      ]
    },
    "sourceFormat": {
      "enum": [
        "mermaid",
        "planr-diagram-bundle"
      ]
    },
    "targetFormat": {
      "enum": [
        "mermaid",
        "planr-diagram-bundle",
        "svg",
        "html",
        "png"
      ]
    },
    "semantic": {
      "enum": [
        "lossless",
        "partial",
        "unsupported"
      ]
    },
    "presentation": {
      "enum": [
        "lossless",
        "partial",
        "unsupported"
      ]
    },
    "sourceText": {
      "enum": [
        "lossless",
        "partial",
        "unsupported"
      ]
    },
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "semantic",
              "presentation",
              "sourceText"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "elementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 10000,
            "uniqueItems": true
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "dimension",
          "code",
          "elementIds",
          "message"
        ]
      },
      "minItems": 0,
      "maxItems": 1024
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "diagramId",
    "basis",
    "sourceDigest",
    "sourceFormat",
    "targetFormat",
    "semantic",
    "presentation",
    "sourceText",
    "losses"
  ]
}
