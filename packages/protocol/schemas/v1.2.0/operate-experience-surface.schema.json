{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://openplanr.dev/schemas/v1.2.0/operate-experience-surface.schema.json",
	"x-openplanr-contract": {
		"id": "operate-experience-surface",
		"version": "1.0.0"
	},
	"title": "OpenPlanr dashboard Operate experience surface",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"ok",
		"kind",
		"schemaVersion",
		"protocolVersion",
		"surface",
		"readOnly",
		"mutationEnabled",
		"scopeId",
		"domainId",
		"domainVersion",
		"actorId",
		"accessLevel",
		"generatedAt",
		"eventHead",
		"viewHash",
		"truthSummary",
		"status",
		"reasonCodes",
		"data"
	],
	"properties": {
		"ok": { "const": true },
		"kind": { "const": "operate-experience-surface" },
		"schemaVersion": { "const": "1.0.0" },
		"protocolVersion": { "const": "2.0.0" },
		"surface": {
			"enum": [
				"today",
				"inbox",
				"cycles",
				"cycle",
				"actions",
				"action",
				"evidence",
				"outcomes",
				"outcome",
				"history",
				"search",
				"export"
			]
		},
		"readOnly": { "const": true },
		"mutationEnabled": { "type": "boolean" },
		"scopeId": {
			"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/id"
		},
		"domainId": {
			"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/id"
		},
		"domainVersion": {
			"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/version"
		},
		"actorId": {
			"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/id"
		},
		"accessLevel": {
			"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/accessLevel"
		},
		"generatedAt": { "type": "string", "format": "date-time" },
		"eventHead": {
			"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/eventHead"
		},
		"viewHash": {
			"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/hash"
		},
		"truthSummary": {
			"$ref": "../v2.0.0/operate-review-display-workspace.schema.json#/$defs/sharedTruthSummary"
		},
		"status": {
			"enum": [
				"ready",
				"read-only",
				"stale",
				"partial",
				"blocked",
				"offline",
				"incompatible",
				"corrupt"
			]
		},
		"reasonCodes": {
			"type": "array",
			"uniqueItems": true,
			"items": { "type": "string" }
		},
		"data": {}
	},
	"allOf": [
		{
			"if": {
				"properties": { "surface": { "const": "today" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/todayData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "inbox" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/inboxData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "cycles" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/cyclesData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "cycle" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/cycleData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "actions" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/actionsData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "action" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/actionData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "evidence" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/evidenceData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "outcomes" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/outcomesData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "outcome" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/outcomeData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "history" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/historyData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "search" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/searchData" } } }
		},
		{
			"if": {
				"properties": { "surface": { "const": "export" } },
				"required": ["surface"]
			},
			"then": { "properties": { "data": { "$ref": "#/$defs/exportData" } } }
		},
		{
			"if": {
				"properties": { "status": { "const": "ready" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": true },
					"reasonCodes": { "type": "array", "maxItems": 0 }
				}
			}
		},
		{
			"if": {
				"properties": { "status": { "const": "read-only" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": false },
					"reasonCodes": { "$ref": "#/$defs/readOnlyReasons" }
				}
			}
		},
		{
			"if": {
				"properties": { "status": { "const": "stale" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": false },
					"reasonCodes": { "$ref": "#/$defs/staleReasons" }
				}
			}
		},
		{
			"if": {
				"properties": { "status": { "const": "partial" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": false },
					"reasonCodes": { "$ref": "#/$defs/partialReasons" }
				}
			}
		},
		{
			"if": {
				"properties": { "status": { "const": "blocked" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": false },
					"reasonCodes": { "$ref": "#/$defs/blockedReasons" }
				}
			}
		},
		{
			"if": {
				"properties": { "status": { "const": "offline" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": false },
					"reasonCodes": { "$ref": "#/$defs/offlineReasons" }
				}
			}
		},
		{
			"if": {
				"properties": { "status": { "const": "incompatible" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": false },
					"reasonCodes": { "$ref": "#/$defs/incompatibleReasons" }
				}
			}
		},
		{
			"if": {
				"properties": { "status": { "const": "corrupt" } },
				"required": ["status"]
			},
			"then": {
				"properties": {
					"mutationEnabled": { "const": false },
					"reasonCodes": { "$ref": "#/$defs/corruptReasons" }
				}
			}
		}
	],
	"$defs": {
		"inboxData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["inbox", "requestBinding"],
			"properties": {
				"inbox": {
					"type": "array",
					"items": { "$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/inbox" }
				},
				"requestBinding": {
					"type": "object",
					"additionalProperties": false,
					"required": ["projectId", "generation", "subjectId"],
					"properties": {
						"projectId": { "$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/hash" },
						"generation": { "type": "integer", "minimum": 0 },
						"subjectId": {
							"oneOf": [
								{ "type": "null" },
								{ "$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/id" }
							]
						}
					}
				}
			}
		},
		"todayData": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"attention",
				"domainMetrics",
				"activeCycle",
				"inbox",
				"actions",
				"outcomes",
				"allowedActions"
			],
			"properties": {
				"attention": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/attention"
					}
				},
				"domainMetrics": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/domainMetric"
					}
				},
				"activeCycle": {
					"oneOf": [
						{ "type": "null" },
						{
							"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/cycle"
						}
					]
				},
				"inbox": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/inbox"
					}
				},
				"actions": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/action"
					}
				},
				"outcomes": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/outcome"
					}
				},
				"allowedActions": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/boundAllowedAction"
					}
				}
			}
		},
		"cyclesData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["cycles"],
			"properties": {
				"cycles": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/cycle"
					}
				}
			}
		},
		"cycleData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["cycle"],
			"properties": {
				"cycle": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/cycle"
				}
			}
		},
		"actionsData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["actions", "requestBinding"],
			"properties": {
				"actions": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/action"
					}
				},
				"requestBinding": {
					"type": "object",
					"additionalProperties": false,
					"required": ["projectId", "generation"],
					"properties": {
						"projectId": {
							"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/hash"
						},
						"generation": { "type": "integer", "minimum": 0 }
					}
				}
			}
		},
		"actionData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["action"],
			"properties": {
				"action": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/action"
				}
			}
		},
		"evidenceData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["evidence", "claims", "rationale"],
			"properties": {
				"evidence": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/evidence"
					}
				},
				"claims": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/claim"
					}
				},
				"rationale": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/rationale"
					}
				}
			}
		},
		"outcomesData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["domainMetrics", "outcomes", "learnings"],
			"properties": {
				"domainMetrics": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/domainMetric"
					}
				},
				"outcomes": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/outcome"
					}
				},
				"learnings": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/learning"
					}
				}
			}
		},
		"outcomeData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["outcome", "learnings"],
			"properties": {
				"outcome": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/outcome"
				},
				"learnings": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/learning"
					}
				}
			}
		},
		"historyData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["history", "replay"],
			"properties": {
				"history": {
					"type": "array",
					"items": {
						"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/history"
					}
				},
				"replay": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/replay"
				}
			}
		},
		"searchData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["query", "results"],
			"properties": {
				"query": { "type": "string", "maxLength": 512 },
				"results": {
					"type": "array",
					"items": { "$ref": "#/$defs/searchResult" }
				}
			}
		},
		"searchResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "subjectId", "title", "summary", "state"],
			"properties": {
				"kind": { "type": "string", "minLength": 1, "maxLength": 128 },
				"subjectId": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/id"
				},
				"title": { "type": "string", "minLength": 1, "maxLength": 4096 },
				"summary": { "type": "string", "maxLength": 4096 },
				"state": { "type": "string", "minLength": 1, "maxLength": 128 },
				"deepLink": {
					"$ref": "../v2.0.0/operate-experience-view.schema.json#/$defs/deepLink"
				}
			}
		},
		"exportData": {
			"type": "object",
			"additionalProperties": false,
			"required": ["format", "mediaType", "content"],
			"properties": {
				"format": { "enum": ["json", "html"] },
				"mediaType": {
					"enum": ["application/json", "text/html; charset=utf-8"]
				},
				"content": { "type": "string" }
			}
		},
		"readOnlyReasons": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": { "const": "OPERATE_READ_ONLY" }
		},
		"staleReasons": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": { "const": "OPERATE_PROJECTION_STALE" }
		},
		"partialReasons": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": { "const": "OPERATE_PROJECTION_PARTIAL" }
		},
		"blockedReasons": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": { "const": "OPERATE_PROJECTION_BLOCKED" }
		},
		"offlineReasons": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": { "const": "OPERATE_OFFLINE" }
		},
		"incompatibleReasons": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": { "const": "OPERATE_CONTRACT_INCOMPATIBLE" }
		},
		"corruptReasons": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"items": { "const": "OPERATE_STATE_CORRUPT" }
		}
	}
}
