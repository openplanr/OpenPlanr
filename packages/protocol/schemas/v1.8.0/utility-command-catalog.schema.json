{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.8.0/utility-command-catalog.schema.json",
  "x-openplanr-contract": {
    "id": "utility-command-catalog",
    "version": "1.8.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "semanticBoundary",
    "utilityBoundary",
    "active",
    "retired"
  ],
  "properties": {
    "kind": {
      "const": "openplanr-utility-command-catalog"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.8.0"
    },
    "semanticBoundary": {
      "const": "host-agent"
    },
    "utilityBoundary": {
      "const": "deterministic-cli"
    },
    "active": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "classification"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?: [a-z][a-z0-9-]*)*$"
          },
          "classification": {
            "const": "deterministic-preserved"
          }
        }
      },
      "minItems": 1
    },
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "classification"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?: [a-z][a-z0-9-]*)*$"
          },
          "classification": {
            "enum": [
              "semantic-moved-to-skill",
              "obsolete-governance-retired",
              "obsolete-facade-retired"
            ]
          }
        }
      },
      "minItems": 1
    }
  }
}
