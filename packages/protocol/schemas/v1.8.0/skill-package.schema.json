{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.8.0/skill-package.schema.json",
  "x-openplanr-contract": {
    "id": "skill-package",
    "version": "1.8.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "skillId",
    "skillVersion",
    "entrypoint",
    "hosts",
    "execution",
    "resources"
  ],
  "properties": {
    "kind": {
      "const": "openplanr-skill-package"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.8.0"
    },
    "skillId": {
      "$ref": "common.schema.json#/$defs/skillId"
    },
    "skillVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "entrypoint": {
      "const": "SKILL.md"
    },
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/host"
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "execution": {
      "enum": [
        "host-agent",
        "deterministic-utility"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resource"
      },
      "maxItems": 256
    }
  }
}
