{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/company-resource-upload-status.schema.json",
  "x-openplanr-contract": {
    "id": "company-resource-upload-status",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "status": {
      "enum": [
        "prepared",
        "committed"
      ]
    },
    "receivedChunks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        },
        "required": [
          "index",
          "sha256",
          "byteLength"
        ]
      }
    },
    "receipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://openplanr.dev/schemas/v1.17.0/company-resource-upload-receipt.schema.json",
      "x-openplanr-contract": {
        "id": "company-resource-upload-receipt",
        "version": "1.17.0"
      },
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "2.0.0"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifactId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {
          "const": "committed"
        },
        "committedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": [
        "schemaVersion",
        "organizationId",
        "projectId",
        "artifactId",
        "operationId",
        "revisionId",
        "manifestSha256",
        "contentDigest",
        "status",
        "committedAt"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "status",
    "receivedChunks"
  ]
}
