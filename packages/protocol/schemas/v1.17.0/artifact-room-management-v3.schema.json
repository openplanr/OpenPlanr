{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/artifact-room-management-v3.schema.json",
  "x-openplanr-contract": {
    "id": "artifact-room-management-v3",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "3.0.0"
    },
    "roomId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "operation": {
      "enum": [
        "pause",
        "resume",
        "delete"
      ]
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "expectedGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "roomId",
    "operation",
    "operationId",
    "expectedGeneration",
    "signature"
  ]
}
