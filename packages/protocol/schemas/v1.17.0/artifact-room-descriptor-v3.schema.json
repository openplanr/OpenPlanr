{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/artifact-room-descriptor-v3.schema.json",
  "x-openplanr-contract": {
    "id": "artifact-room-descriptor-v3",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "3.0.0"
    },
    "protocolVersion": {
      "const": "3.0.0"
    },
    "roomId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "reviewCommitment": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ownerKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ECDSA-P256-SHA256"
        },
        "encoding": {
          "const": "spki-base64url"
        },
        "keyId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 86,
          "maxLength": 342
        }
      },
      "required": [
        "algorithm",
        "encoding",
        "keyId",
        "value"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "const": "room-read"
        },
        "reviewer": {
          "const": "reviewer-write"
        },
        "owner": {
          "const": "owner-verdict"
        },
        "management": {
          "const": "room-management"
        }
      },
      "required": [
        "read",
        "reviewer",
        "owner",
        "management"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "roomId",
    "reviewCommitment",
    "ownerKey",
    "capabilities",
    "createdAt"
  ]
}
