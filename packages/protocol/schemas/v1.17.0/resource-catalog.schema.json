{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/resource-catalog.schema.json",
  "x-openplanr-contract": {
    "id": "resource-catalog",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "openplanr-resource-catalog"
    },
    "bundle": {
      "type": "object"
    },
    "uniqueHtmlBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 104857600
    },
    "totalDecodedBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^r[0-9]{1,4}$"
          },
          "type": {
            "enum": [
              "html-segments",
              "shared-block",
              "asset"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 134217728
          },
          "encodedBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          },
          "decodedBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          },
          "codec": {
            "enum": [
              "identity",
              "deflate-raw"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "type",
          "offset",
          "encodedBytes",
          "decodedBytes",
          "codec",
          "sha256"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "resourceId": {
            "type": "string",
            "pattern": "^r[0-9]{1,4}$"
          },
          "htmlBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "resourceId",
          "htmlBytes",
          "sha256"
        ]
      }
    },
    "viewSources": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "reviewOf": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "bundle",
    "uniqueHtmlBytes",
    "totalDecodedBytes",
    "resources",
    "sources",
    "viewSources"
  ]
}
