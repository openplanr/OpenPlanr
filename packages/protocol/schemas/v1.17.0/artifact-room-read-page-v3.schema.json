{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/artifact-room-read-page-v3.schema.json",
  "x-openplanr-contract": {
    "id": "artifact-room-read-page-v3",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "v3"
    },
    "descriptor": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://openplanr.dev/schemas/v1.17.0/artifact-room-descriptor-v3.schema.json",
      "x-openplanr-contract": {
        "id": "artifact-room-descriptor-v3",
        "version": "1.17.0"
      },
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "3.0.0"
        },
        "protocolVersion": {
          "const": "3.0.0"
        },
        "roomId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "reviewCommitment": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ownerKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "ECDSA-P256-SHA256"
            },
            "encoding": {
              "const": "spki-base64url"
            },
            "keyId": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 86,
              "maxLength": 342
            }
          },
          "required": [
            "algorithm",
            "encoding",
            "keyId",
            "value"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "const": "room-read"
            },
            "reviewer": {
              "const": "reviewer-write"
            },
            "owner": {
              "const": "owner-verdict"
            },
            "management": {
              "const": "room-management"
            }
          },
          "required": [
            "read",
            "reviewer",
            "owner",
            "management"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": [
        "schemaVersion",
        "protocolVersion",
        "roomId",
        "reviewCommitment",
        "ownerKey",
        "capabilities",
        "createdAt"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "commentsEnabled": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "head": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "eventBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://openplanr.dev/schemas/v1.17.0/artifact-room-event-v3.schema.json",
        "x-openplanr-contract": {
          "id": "artifact-room-event-v3",
          "version": "1.17.0"
        },
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": "3.0.0"
          },
          "protocolVersion": {
            "const": "3.0.0"
          },
          "roomId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "eventId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "predecessor": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "pin",
              "reply",
              "pin_status",
              "recommendation",
              "owner_decision",
              "review_snapshot"
            ]
          },
          "reviewCommitment": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "authorRole": {
            "enum": [
              "owner",
              "reviewer"
            ]
          },
          "authorKey": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "const": "ECDSA-P256-SHA256"
              },
              "encoding": {
                "const": "spki-base64url"
              },
              "keyId": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "value": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "minLength": 86,
                "maxLength": 342
              }
            },
            "required": [
              "algorithm",
              "encoding",
              "keyId",
              "value"
            ]
          },
          "capability": {
            "enum": [
              "reviewer-write",
              "owner-verdict"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "iv": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16}$"
          },
          "ciphertext": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "minLength": 22,
            "maxLength": 349526
          },
          "ciphertextDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$"
          }
        },
        "required": [
          "schemaVersion",
          "protocolVersion",
          "roomId",
          "eventId",
          "sequence",
          "predecessor",
          "kind",
          "reviewCommitment",
          "authorRole",
          "authorKey",
          "capability",
          "createdAt",
          "iv",
          "ciphertext",
          "ciphertextDigest",
          "signature"
        ]
      }
    },
    "nextCursor": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "iv": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16}$"
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 22,
      "maxLength": 6990507
    }
  },
  "required": [
    "version",
    "descriptor",
    "expiresAt",
    "commentsEnabled",
    "generation",
    "sequence",
    "head",
    "cursor",
    "eventBytes",
    "events",
    "nextCursor"
  ]
}
