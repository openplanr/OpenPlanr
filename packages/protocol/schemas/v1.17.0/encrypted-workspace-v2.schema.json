{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/encrypted-workspace-v2.schema.json",
  "x-openplanr-contract": {
    "id": "encrypted-workspace-v2",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "currentRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "ownerPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ]
    },
    "keyring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iv": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16}$"
        },
        "ciphertext": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 65536
        }
      },
      "required": [
        "iv",
        "ciphertext"
      ]
    },
    "commentsPaused": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "epoch",
    "currentRevision",
    "ownerPublicKey",
    "keyring",
    "commentsPaused"
  ]
}
