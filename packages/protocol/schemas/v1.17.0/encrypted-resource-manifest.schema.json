{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/encrypted-resource-manifest.schema.json",
  "x-openplanr-contract": {
    "id": "encrypted-resource-manifest",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "openplanr-encrypted-resource-manifest"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "plaintextBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "ciphertextBytes": {
      "type": "integer",
      "minimum": 17,
      "maximum": 134219792
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        },
        "encodedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "decodedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "codec": {
          "enum": [
            "identity",
            "deflate-raw"
          ]
        }
      },
      "required": [
        "offset",
        "encodedBytes",
        "decodedBytes",
        "codec"
      ]
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 129,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "byteLength": {
            "type": "integer",
            "minimum": 17,
            "maximum": 1048576
          },
          "iv": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "index",
          "byteLength",
          "iv",
          "sha256"
        ]
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "workspaceId",
    "revisionId",
    "epoch",
    "createdAt",
    "plaintextBytes",
    "ciphertextBytes",
    "catalog",
    "chunks",
    "signature"
  ]
}
