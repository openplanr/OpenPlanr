{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/company-resource-upload-prepare.schema.json",
  "x-openplanr-contract": {
    "id": "company-resource-upload-prepare",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "baseRevisionId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://openplanr.dev/schemas/v1.17.0/company-resource-manifest.schema.json",
      "x-openplanr-contract": {
        "id": "company-resource-manifest",
        "version": "1.17.0"
      },
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "2.0.0"
        },
        "kind": {
          "const": "openplanr-company-resource-manifest"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifactId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,64}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "contentType": {
          "const": "application/json"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "decodedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            },
            "encodedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "decodedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "codec": {
              "enum": [
                "identity",
                "deflate-raw"
              ]
            }
          },
          "required": [
            "offset",
            "encodedBytes",
            "decodedBytes",
            "codec"
          ]
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "index",
              "byteLength",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "organizationId",
        "projectId",
        "artifactId",
        "revisionId",
        "contentDigest",
        "contentType",
        "byteLength",
        "decodedBytes",
        "catalog",
        "chunks"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "baseRevisionId",
    "manifest"
  ]
}
