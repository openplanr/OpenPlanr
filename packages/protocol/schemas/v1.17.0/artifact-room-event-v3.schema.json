{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.17.0/artifact-room-event-v3.schema.json",
  "x-openplanr-contract": {
    "id": "artifact-room-event-v3",
    "version": "1.17.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "3.0.0"
    },
    "protocolVersion": {
      "const": "3.0.0"
    },
    "roomId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "predecessor": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "pin",
        "reply",
        "pin_status",
        "recommendation",
        "owner_decision",
        "review_snapshot"
      ]
    },
    "reviewCommitment": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorRole": {
      "enum": [
        "owner",
        "reviewer"
      ]
    },
    "authorKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ECDSA-P256-SHA256"
        },
        "encoding": {
          "const": "spki-base64url"
        },
        "keyId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 86,
          "maxLength": 342
        }
      },
      "required": [
        "algorithm",
        "encoding",
        "keyId",
        "value"
      ]
    },
    "capability": {
      "enum": [
        "reviewer-write",
        "owner-verdict"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "iv": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16}$"
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 22,
      "maxLength": 349526
    },
    "ciphertextDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "roomId",
    "eventId",
    "sequence",
    "predecessor",
    "kind",
    "reviewCommitment",
    "authorRole",
    "authorKey",
    "capability",
    "createdAt",
    "iv",
    "ciphertext",
    "ciphertextDigest",
    "signature"
  ]
}
