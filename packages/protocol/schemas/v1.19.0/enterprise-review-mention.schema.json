{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.19.0/enterprise-review-mention.schema.json",
  "x-openplanr-contract": {
    "id": "enterprise-review-mention",
    "version": "1.19.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "openplanr-enterprise-review-mention"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.19.0"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}(?![\\s\\S])"
    },
    "actorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "threadId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,64}$"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
            }
          ]
        },
        "elementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "screenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "frameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "revisionId"
      ],
      "anyOf": [
        {
          "required": [
            "elementId"
          ]
        },
        {
          "required": [
            "screenId",
            "frameId"
          ]
        },
        {
          "required": [
            "x",
            "y"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "x"
            ]
          },
          "then": {
            "required": [
              "y"
            ]
          }
        },
        {
          "if": {
            "required": [
              "y"
            ]
          },
          "then": {
            "required": [
              "x"
            ]
          }
        },
        {
          "if": {
            "required": [
              "frameId"
            ]
          },
          "then": {
            "required": [
              "screenId"
            ]
          }
        }
      ]
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
      },
      "maxItems": 50,
      "minItems": 1,
      "uniqueItems": true
    },
    "authority": {
      "const": "notification-only"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "organizationId",
    "projectId",
    "artifactId",
    "operationId",
    "actorId",
    "threadId",
    "anchor",
    "recipients",
    "authority"
  ]
}
