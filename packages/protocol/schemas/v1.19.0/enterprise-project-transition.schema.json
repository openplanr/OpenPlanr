{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.19.0/enterprise-project-transition.schema.json",
  "x-openplanr-contract": {
    "id": "enterprise-project-transition",
    "version": "1.19.0"
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "openplanr-enterprise-project-transition"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.19.0"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,64}(?![\\s\\S])"
    },
    "actorId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "action": {
      "enum": [
        "archive",
        "restore"
      ]
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "organizationId",
    "projectId",
    "operationId",
    "actorId",
    "action",
    "expectedVersion",
    "expectedEpoch"
  ]
}
