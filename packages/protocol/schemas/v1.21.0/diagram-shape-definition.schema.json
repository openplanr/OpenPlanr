{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.21.0/diagram-shape-definition.schema.json",
  "x-openplanr-contract": {
    "id": "diagram-shape-definition",
    "version": "1.21.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packId",
    "packVersion",
    "shapeId",
    "definitionDigest",
    "name",
    "description",
    "tags",
    "primitives",
    "attachment",
    "textRegion",
    "sizing"
  ],
  "properties": {
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "packVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "shapeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "definitionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "x",
              "y",
              "width",
              "height",
              "radius",
              "fill",
              "stroke"
            ],
            "properties": {
              "type": {
                "const": "rect"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fill": {
                "enum": [
                  "fill",
                  "none"
                ]
              },
              "stroke": {
                "enum": [
                  "stroke",
                  "none"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "cx",
              "cy",
              "rx",
              "ry",
              "fill",
              "stroke"
            ],
            "properties": {
              "type": {
                "const": "ellipse"
              },
              "cx": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rx": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "ry": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "fill": {
                "enum": [
                  "fill",
                  "none"
                ]
              },
              "stroke": {
                "enum": [
                  "stroke",
                  "none"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "points",
              "fill",
              "stroke"
            ],
            "properties": {
              "type": {
                "const": "polygon"
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              "fill": {
                "enum": [
                  "fill",
                  "none"
                ]
              },
              "stroke": {
                "enum": [
                  "stroke",
                  "none"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "x1",
              "y1",
              "x2",
              "y2",
              "stroke"
            ],
            "properties": {
              "type": {
                "const": "line"
              },
              "x1": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y1": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "x2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y2": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "stroke": {
                "enum": [
                  "stroke",
                  "none"
                ]
              }
            }
          }
        ]
      }
    },
    "attachment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y",
            "width",
            "height",
            "radius"
          ],
          "properties": {
            "type": {
              "const": "rect"
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cx",
            "cy",
            "rx",
            "ry"
          ],
          "properties": {
            "type": {
              "const": "ellipse"
            },
            "cx": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rx": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "ry": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points"
          ],
          "properties": {
            "type": {
              "const": "polygon"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "textRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "minWidth",
        "minHeight"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "minWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "minHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        }
      }
    }
  }
}
