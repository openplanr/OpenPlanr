{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.25.0/command-catalog.schema.json",
  "x-openplanr-contract": {
    "id": "command-catalog",
    "version": "1.25.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "binaries",
    "inventory",
    "commands",
    "negativeContracts"
  ],
  "properties": {
    "kind": {
      "const": "command-catalog"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.25.0"
    },
    "documentVersion": {
      "$ref": "#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "binaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lifecycle",
          "aliasOf"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "lifecycle": {
            "enum": [
              "canonical",
              "exact-alias",
              "deprecated-exact-alias"
            ]
          },
          "aliasOf": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootCommandModules",
        "rootCommandSlugs",
        "pipelineMachineLeaves",
        "pipelineMachineGrammar",
        "frozenClaudeDocuments",
        "frozenClaudeSlugs"
      ],
      "properties": {
        "rootCommandModules": {
          "const": 39
        },
        "rootCommandSlugs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 39,
          "maxItems": 39,
          "uniqueItems": true
        },
        "pipelineMachineLeaves": {
          "const": 31
        },
        "pipelineMachineGrammar": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 8
          },
          "minItems": 31,
          "maxItems": 31
        },
        "frozenClaudeDocuments": {
          "const": 8
        },
        "frozenClaudeSlugs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commandId",
          "surface",
          "argv",
          "lifecycle",
          "ownerPackage",
          "source",
          "authorityClass",
          "machineJson",
          "outputContracts",
          "skillId",
          "aliases",
          "testRefs"
        ],
        "properties": {
          "commandId": {
            "$ref": "#/$defs/identifier"
          },
          "surface": {
            "enum": [
              "cli-root",
              "cli-leaf",
              "pipeline-machine",
              "frozen-host-alias"
            ]
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 16
          },
          "lifecycle": {
            "enum": [
              "active",
              "compatibility-alias",
              "deprecated"
            ]
          },
          "ownerPackage": {
            "$ref": "#/$defs/nonBlankText"
          },
          "source": {
            "$ref": "#/$defs/sourceRef"
          },
          "authorityClass": {
            "$ref": "#/$defs/identifier"
          },
          "machineJson": {
            "type": "boolean"
          },
          "outputContracts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/contractRef"
            },
            "minItems": 0,
            "maxItems": 32
          },
          "skillId": {
            "anyOf": [
              {
                "$ref": "#/$defs/skillId"
              },
              {
                "type": "null"
              }
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 16
            },
            "minItems": 0,
            "maxItems": 32
          },
          "testRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 512
    },
    "negativeContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "negativeContractId",
          "forbiddenArgvPrefix",
          "forbiddenPaths",
          "reason",
          "testRefs"
        ],
        "properties": {
          "negativeContractId": {
            "$ref": "#/$defs/identifier"
          },
          "forbiddenArgvPrefix": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 16
          },
          "forbiddenPaths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "reason": {
            "$ref": "#/$defs/nonBlankText"
          },
          "testRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "$defs": {
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "nonBlankText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": ".*\\S.*"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "skillId": {
      "type": "string",
      "pattern": "^planr-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
