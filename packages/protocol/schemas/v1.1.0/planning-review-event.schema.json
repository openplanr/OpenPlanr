{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/planning-review-event.schema.json",
  "title": "OpenPlanr Protocol 1.1 planning review event",
  "oneOf": [
    {
      "title": "consolidated review close", "type": "object", "additionalProperties": false,
      "required": ["type", "expectedGeneration", "phase", "candidateRevision", "candidateDigest", "reviewerIds", "contributions", "findings", "dissent", "reviewedFindingIds", "summary"],
      "properties": {
        "type": { "const": "review.closed" },
        "expectedGeneration": { "type": "integer", "minimum": 0 },
        "phase": { "type": "string", "enum": ["initial", "targeted"] },
        "candidateRevision": { "type": "integer", "minimum": 1, "maximum": 2 },
        "candidateDigest": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/digest" },
        "reviewerIds": { "type": "array", "minItems": 4, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/reviewerId" } },
        "contributions": { "type": "array", "minItems": 4, "maxItems": 9, "items": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/contribution" } },
        "findings": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "severity", "basis", "title", "evidence", "artifactRefs", "acceptanceRefs", "disposition"],
            "properties": {
              "id": { "type": ["string", "null"], "pattern": "^pfnd_[a-f0-9]{32}$" },
              "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
              "basis": { "type": "string", "enum": ["scope", "acceptance", "feasibility", "design", "devex", "security", "performance", "migration", "api-contract", "data-integrity"] },
              "title": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/text" },
              "evidence": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/text" },
              "artifactRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:SPEC|FEAT|US|T)-[0-9]{3}$" } },
              "acceptanceRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
              "disposition": { "type": "string", "enum": ["open", "resolved", "remains", "deferred"] }
            }
          }
        },
        "dissent": { "type": "array", "maxItems": 9, "items": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/dissent" } },
        "reviewedFindingIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/findingId" } },
        "summary": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/text" }
      }
    },
    {
      "title": "single correction", "type": "object", "additionalProperties": false,
      "required": ["type", "expectedGeneration", "expectedPlanDigest", "summary", "findingIds"],
      "properties": {
        "type": { "const": "correction.registered" },
        "expectedGeneration": { "type": "integer", "minimum": 0 },
        "expectedPlanDigest": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/digest" },
        "summary": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/text" },
        "findingIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/findingId" } }
      }
    },
    {
      "title": "owner decision", "type": "object", "additionalProperties": false,
      "required": ["type", "expectedGeneration", "ownerId", "decision", "reason", "candidateRevision", "planDigest"],
      "properties": {
        "type": { "const": "owner.decided" },
        "expectedGeneration": { "type": "integer", "minimum": 0 },
        "ownerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,159}$" },
        "decision": { "type": "string", "enum": ["approved", "blocked"] },
        "reason": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/text" },
        "candidateRevision": { "type": "integer", "minimum": 1, "maximum": 2 },
        "planDigest": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/digest" }
      }
    }
  ]
}
