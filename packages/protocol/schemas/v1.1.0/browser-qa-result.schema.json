{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/browser-qa-result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schemaVersion", "candidateDigest", "requirementDigest", "status", "signedIn", "sessionId", "origin", "routeIds", "formIds", "viewports", "accessibility", "console", "network", "screenshots", "traces", "failures"],
  "properties": {
    "kind": { "const": "browser-qa-result" }, "schemaVersion": { "const": "1.0.0" },
    "candidateDigest": { "$ref": "#/$defs/digest" }, "requirementDigest": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["passed", "failed", "unavailable", "skipped"] }, "signedIn": { "type": "boolean" },
    "sessionId": { "type": ["string", "null"], "pattern": "^bqs_[a-f0-9]{32}$" },
    "origin": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "routeIds": { "$ref": "#/$defs/ids" }, "formIds": { "$ref": "#/$defs/ids" },
    "viewports": { "type": "array", "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["id", "width", "height", "horizontalOverflow"], "properties": { "id": { "$ref": "#/$defs/id" }, "width": { "type": "integer", "minimum": 240, "maximum": 7680 }, "height": { "type": "integer", "minimum": 240, "maximum": 7680 }, "horizontalOverflow": { "type": "boolean" } } } },
    "accessibility": { "$ref": "#/$defs/countEvidence" }, "console": { "$ref": "#/$defs/countEvidence" }, "network": { "$ref": "#/$defs/countEvidence" },
    "screenshots": { "$ref": "#/$defs/evidence" }, "traces": { "$ref": "#/$defs/evidence" },
    "failures": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["code", "messageDigest"], "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }, "messageDigest": { "$ref": "#/$defs/digest" } } } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$" },
    "ids": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "countEvidence": { "type": "object", "additionalProperties": false, "required": ["failureCount", "evidenceDigest"], "properties": { "failureCount": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "evidenceDigest": { "$ref": "#/$defs/digest" } } },
    "evidence": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["id", "contentDigest"], "properties": { "id": { "$ref": "#/$defs/id" }, "contentDigest": { "$ref": "#/$defs/digest" } } } }
  }
}
