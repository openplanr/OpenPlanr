{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://openplanr.dev/schemas/v1.1.0/investigation-experiment.schema.json",
  "title": "OpenPlanr Protocol 1.1 discriminating experiment", "type": "object", "additionalProperties": false,
  "required": ["id", "name", "kind", "command", "hypothesisIds", "predictions", "outcome", "resultByHypothesis", "approval", "evidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^exp_[a-f0-9]{32}$" }, "name": { "$ref": "#/$defs/text" }, "kind": { "enum": ["read-only", "destructive", "live", "network"] },
    "command": { "$ref": "#/$defs/command" }, "hypothesisIds": { "type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^hyp_[a-f0-9]{32}$" } },
    "predictions": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["hypothesisId", "expected"], "properties": { "hypothesisId": { "type": "string", "pattern": "^hyp_[a-f0-9]{32}$" }, "expected": { "$ref": "#/$defs/text" } } } },
    "outcome": { "$ref": "#/$defs/text" }, "resultByHypothesis": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["hypothesisId", "disposition"], "properties": { "hypothesisId": { "type": "string", "pattern": "^hyp_[a-f0-9]{32}$" }, "disposition": { "enum": ["supported", "rejected", "inconclusive"] } } } },
    "approval": { "type": ["object", "null"] }, "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "command": { "type": "object", "additionalProperties": false, "required": ["id", "repositoryKey", "argv", "inputPaths", "expectedExitCodes", "effect"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 64 }, "repositoryKey": { "type": "string", "minLength": 1, "maxLength": 64 }, "argv": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "inputPaths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "expectedExitCodes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }, "effect": { "enum": ["read-only", "destructive", "live", "network"] } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["commandId", "commandDigest", "startedAt", "completedAt", "status", "exitCode", "matchedExpectation", "outputBytes", "outputDigest", "truncated", "evidenceDigest"], "properties": { "commandId": { "type": "string", "minLength": 1, "maxLength": 64 }, "commandDigest": { "$ref": "#/$defs/digest" }, "startedAt": { "type": "string", "format": "date-time" }, "completedAt": { "type": "string", "format": "date-time" }, "status": { "enum": ["completed", "unavailable", "output-limit"] }, "exitCode": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 }, "matchedExpectation": { "type": "boolean" }, "outputBytes": { "type": "integer", "minimum": 0 }, "outputDigest": { "$ref": "#/$defs/digest" }, "truncated": { "type": "boolean" }, "evidenceDigest": { "$ref": "#/$defs/digest" } } }
  }
}
