{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://openplanr.dev/schemas/v1.1.0/investigation-hypothesis.schema.json",
  "title": "OpenPlanr Protocol 1.1 ranked investigation hypothesis", "type": "object", "additionalProperties": false,
  "required": ["id", "rank", "statement", "observationIds"],
  "properties": { "id": { "type": "string", "pattern": "^hyp_[a-f0-9]{32}$" }, "rank": { "type": "integer", "minimum": 1, "maximum": 32 }, "statement": { "type": "string", "minLength": 1, "maxLength": 4000 }, "observationIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^obs_[a-f0-9]{32}$" } } }
}
