{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://openplanr.dev/schemas/v1.1.0/investigation-diagnosis.schema.json",
  "title": "OpenPlanr Protocol 1.1 proven or unknown diagnosis", "type": "object", "additionalProperties": false,
  "required": ["status", "causeHypothesisId", "experimentIds", "confidence", "affectedScope", "proposedRegression", "summary"],
  "properties": {
    "status": { "enum": ["proven", "unknown"] }, "causeHypothesisId": { "type": ["string", "null"], "pattern": "^hyp_[a-f0-9]{32}$" },
    "experimentIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^exp_[a-f0-9]{32}$" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "affectedScope": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["repositoryKey", "path"], "properties": { "repositoryKey": { "type": "string", "minLength": 1, "maxLength": 64 }, "path": { "type": "string", "minLength": 1, "maxLength": 512 } } } },
    "proposedRegression": { "type": "object" }, "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
  }
}
