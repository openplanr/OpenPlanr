{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/professional-skills.schema.json",
  "title": "Professional skills catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "protocolVersion", "catalogVersion", "digestAlgorithm", "skills"],
  "properties": {
    "kind": { "const": "professional-skills" },
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.1.0" },
    "catalogVersion": { "const": "1.0.0" },
    "digestAlgorithm": { "const": "sha256" },
    "skills": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "cliRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "requiredOptions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        },
        "requiredOptions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" }
        },
        "inputOptions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" }
        },
        "authority": { "enum": ["agent", "owner-only"] }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "entrypoint", "path"],
      "properties": {
        "host": { "enum": ["claude-code", "codex", "cursor"] },
        "entrypoint": { "type": "string", "minLength": 1, "maxLength": 96 },
        "path": {
          "type": "string",
          "pattern": "^(skills/[a-z0-9-]+/SKILL\\.md|adapters/codex/skills/[a-z0-9-]+/SKILL\\.md|adapters/cursor/rules/openplanr-[a-z0-9-]+\\.mdc)$"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "sourceOwner", "sourceVersion", "sourceSnapshot", "sourceDigest", "contracts", "authorityClass", "triggerPolicy", "cliRequirements", "hosts"],
      "properties": {
        "skillId": { "enum": ["planr-browser-qa", "planr-investigate", "planr-plan-review", "planr-spec"] },
        "sourceOwner": { "const": "skills" },
        "sourceVersion": { "const": "1.0.0" },
        "sourceSnapshot": { "type": "string", "minLength": 80, "maxLength": 12000 },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/contract" } },
            "outputs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/contract" } }
          }
        },
        "authorityClass": { "enum": ["planning-write", "review-evidence", "diagnose-or-authorized-fix", "quality-evidence"] },
        "triggerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude", "deferTo"],
          "properties": {
            "include": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 3, "maxLength": 160 } },
            "exclude": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 3, "maxLength": 160 } },
            "deferTo": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" } }
          }
        },
        "cliRequirements": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/cliRequirement" } },
        "hosts": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/host" } }
      }
    }
  }
}
