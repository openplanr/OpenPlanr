{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.1.0/planning-review-receipt.schema.json",
  "title": "OpenPlanr Protocol 1.1 immutable planning review receipt",
  "allOf": [
    { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json" },
    {
      "type": "object",
      "required": ["recordType", "state", "ownerDecision", "terminal", "receiptHash"],
      "properties": {
        "recordType": { "const": "receipt" },
        "state": { "type": "string", "enum": ["passed", "blocked"] },
        "ownerDecision": { "type": "object" },
        "terminal": { "type": "object" },
        "receiptHash": { "$ref": "https://openplanr.dev/schemas/v1.1.0/planning-review-record.schema.json#/$defs/digest" }
      }
    }
  ]
}
