{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.6.0/diagram-type-registry.schema.json",
  "x-openplanr-contract": {
    "id": "diagram-type-registry",
    "version": "1.6.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "registryVersion",
    "primitives",
    "layoutFamilies",
    "grammars"
  ],
  "properties": {
    "kind": {
      "const": "diagram-type-registry"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.6.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "registryVersion": {
      "const": "1.0.0"
    },
    "primitives": {
      "type": "array",
      "items": {
        "enum": [
          "node",
          "relation",
          "group",
          "lane",
          "event",
          "series",
          "axis",
          "set",
          "annotation",
          "emphasis"
        ]
      },
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true
    },
    "layoutFamilies": {
      "type": "array",
      "items": {
        "enum": [
          "cause-effect",
          "chart",
          "chronology",
          "containment",
          "entity",
          "graph",
          "hierarchy",
          "lanes",
          "sankey",
          "wardley"
        ]
      },
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true
    },
    "grammars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grammarId",
          "grammarVersion",
          "title",
          "summary",
          "layoutFamily",
          "aliases",
          "requiredPrimitives",
          "allowedPrimitives",
          "directions",
          "detailLimits",
          "readability",
          "projections",
          "fixture",
          "reference",
          "rendererContract",
          "accessibilityTemplate"
        ],
        "properties": {
          "grammarId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "grammarVersion": {
            "const": "1.0.0"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "summary": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "layoutFamily": {
            "enum": [
              "cause-effect",
              "chart",
              "chronology",
              "containment",
              "entity",
              "graph",
              "hierarchy",
              "lanes",
              "sankey",
              "wardley"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true
          },
          "requiredPrimitives": {
            "type": "array",
            "items": {
              "enum": [
                "node",
                "relation",
                "group",
                "lane",
                "event",
                "series",
                "axis",
                "set",
                "annotation",
                "emphasis"
              ]
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "allowedPrimitives": {
            "type": "array",
            "items": {
              "enum": [
                "node",
                "relation",
                "group",
                "lane",
                "event",
                "series",
                "axis",
                "set",
                "annotation",
                "emphasis"
              ]
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "directions": {
            "type": "array",
            "items": {
              "enum": [
                "top-down",
                "left-right",
                "right-left",
                "bottom-up",
                "radial"
              ]
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "detailLimits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "simplified",
              "balanced",
              "faithful",
              "hard"
            ],
            "properties": {
              "simplified": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "balanced": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "faithful": {
                "type": "integer",
                "minimum": 1,
                "maximum": 48
              },
              "hard": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              }
            }
          },
          "readability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maxLabelCharacters",
              "maxCrossings",
              "maxFanIn",
              "minTextSize",
              "aspectRatios"
            ],
            "properties": {
              "maxLabelCharacters": {
                "type": "integer",
                "minimum": 8,
                "maximum": 256
              },
              "maxCrossings": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "maxFanIn": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "minTextSize": {
                "type": "integer",
                "minimum": 9,
                "maximum": 24
              },
              "aspectRatios": {
                "type": "array",
                "items": {
                  "enum": [
                    "fit",
                    "doc-inline",
                    "doc-wide",
                    "slide-16x9",
                    "slide-4x3",
                    "social-square",
                    "print-landscape"
                  ]
                },
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true
              }
            }
          },
          "projections": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mermaid",
              "excalidraw"
            ],
            "properties": {
              "mermaid": {
                "enum": [
                  "editable",
                  "render-only",
                  "partial",
                  "lossy",
                  "unsupported"
                ]
              },
              "excalidraw": {
                "enum": [
                  "editable",
                  "render-only",
                  "partial",
                  "lossy",
                  "unsupported"
                ]
              }
            }
          },
          "fixture": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "reference": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "rendererContract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "layoutFamily",
              "contractVersion",
              "staticByDefault"
            ],
            "properties": {
              "layoutFamily": {
                "enum": [
                  "cause-effect",
                  "chart",
                  "chronology",
                  "containment",
                  "entity",
                  "graph",
                  "hierarchy",
                  "lanes",
                  "sankey",
                  "wardley"
                ]
              },
              "contractVersion": {
                "$ref": "common.schema.json#/$defs/semver"
              },
              "staticByDefault": {
                "const": true
              }
            }
          },
          "accessibilityTemplate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description"
            ],
            "properties": {
              "title": {
                "$ref": "common.schema.json#/$defs/nonBlankText"
              },
              "description": {
                "$ref": "common.schema.json#/$defs/nonBlankText"
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    }
  }
}
