{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.5.0/task-kind-registry.schema.json",
  "x-openplanr-contract": {
    "id": "task-kind-registry",
    "version": "1.5.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "roleRegistryDigest",
    "bindings",
    "legacyMappings"
  ],
  "properties": {
    "kind": {
      "const": "task-kind-registry"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.5.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "roleRegistryDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskKind",
          "roleId",
          "assignmentLevel",
          "countsTowardR2",
          "implementationAuthority",
          "description",
          "inputContracts",
          "outputContracts",
          "requiredRuleIds"
        ],
        "properties": {
          "taskKind": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "roleId": {
            "$ref": "common.schema.json#/$defs/roleId"
          },
          "assignmentLevel": {
            "enum": [
              "story",
              "preflight",
              "feature",
              "quality"
            ]
          },
          "countsTowardR2": {
            "type": "boolean"
          },
          "implementationAuthority": {
            "type": "boolean"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "inputContracts": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/contractRef"
            },
            "minItems": 0,
            "maxItems": 32
          },
          "outputContracts": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/contractRef"
            },
            "minItems": 1,
            "maxItems": 32
          },
          "requiredRuleIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/ruleId"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    },
    "legacyMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legacyType",
          "legacyAgent",
          "taskKind",
          "evidence",
          "precedence"
        ],
        "properties": {
          "legacyType": {
            "enum": [
              "UI",
              "Tech"
            ]
          },
          "legacyAgent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+-agent$"
              },
              {
                "type": "null"
              }
            ]
          },
          "taskKind": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "evidence": {
            "enum": [
              "explicit-type-and-agent",
              "explicit-type-default"
            ]
          },
          "precedence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        }
      },
      "minItems": 1,
      "maxItems": 32
    }
  }
}
