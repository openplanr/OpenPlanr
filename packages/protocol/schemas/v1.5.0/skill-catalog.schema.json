{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplanr.dev/schemas/v1.5.0/skill-catalog.schema.json",
  "x-openplanr-contract": {
    "id": "skill-catalog",
    "version": "1.5.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "protocolVersion",
    "documentVersion",
    "digestAlgorithm",
    "canonicalization",
    "documentDigest",
    "matchingPolicyVersion",
    "skills",
    "compatibilityAliases"
  ],
  "properties": {
    "kind": {
      "const": "skill-catalog"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "protocolVersion": {
      "const": "1.5.0"
    },
    "documentVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "rfc8785"
    },
    "documentDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "matchingPolicyVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skillId",
          "skillVersion",
          "description",
          "lifecycle",
          "authorityClass",
          "source",
          "sourceDigest",
          "triggerPolicy",
          "contracts",
          "cliRequirements",
          "ruleIds",
          "contributionManifestRefs",
          "hosts",
          "testRefs",
          "certificationRefs"
        ],
        "properties": {
          "skillId": {
            "$ref": "common.schema.json#/$defs/skillId"
          },
          "skillVersion": {
            "$ref": "common.schema.json#/$defs/semver"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/nonBlankText"
          },
          "lifecycle": {
            "enum": [
              "active",
              "deprecated",
              "retired"
            ]
          },
          "authorityClass": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "sourceDigest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "triggerPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "include",
              "exclude",
              "deferTo"
            ],
            "properties": {
              "include": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/nonBlankText"
                },
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true
              },
              "exclude": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/nonBlankText"
                },
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true
              },
              "deferTo": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/skillId"
                },
                "minItems": 0,
                "maxItems": 32,
                "uniqueItems": true
              }
            }
          },
          "contracts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputs",
              "outputs"
            ],
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/contractRef"
                },
                "minItems": 0,
                "maxItems": 32
              },
              "outputs": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/contractRef"
                },
                "minItems": 1,
                "maxItems": 32
              }
            }
          },
          "cliRequirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commandId",
                "argv",
                "requiredOptions"
              ],
              "properties": {
                "commandId": {
                  "$ref": "common.schema.json#/$defs/identifier"
                },
                "argv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 16
                },
                "requiredOptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^--[a-z0-9-]+$"
                  },
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": true
                }
              }
            },
            "minItems": 0,
            "maxItems": 64
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/ruleId"
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          },
          "contributionManifestRefs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/relativePath"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host",
                "entrypoint",
                "path"
              ],
              "properties": {
                "host": {
                  "enum": [
                    "claude-code",
                    "codex",
                    "cursor"
                  ]
                },
                "entrypoint": {
                  "$ref": "common.schema.json#/$defs/nonBlankText"
                },
                "path": {
                  "$ref": "common.schema.json#/$defs/relativePath"
                }
              }
            },
            "minItems": 1,
            "maxItems": 8
          },
          "testRefs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/relativePath"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          },
          "certificationRefs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/relativePath"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    },
    "compatibilityAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aliasId",
          "canonicalSkillId",
          "lifecycle",
          "generatedPaths"
        ],
        "properties": {
          "aliasId": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "canonicalSkillId": {
            "$ref": "common.schema.json#/$defs/skillId"
          },
          "lifecycle": {
            "const": "deprecated"
          },
          "generatedPaths": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/relativePath"
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    }
  }
}
