{
  "name": "@openplanr/operate",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Canonical OpenPlanr Operate runtime",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/operate/runtime-foundation.d.mts",
      "import": "./lib/operate/runtime-foundation.mjs",
      "default": "./lib/operate/runtime-foundation.mjs"
    },
    "./package.json": "./package.json",
    "./*": "./lib/operate/*"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openplanr/protocol": "0.3.0"
  },
  "scripts": {
    "generate": "node scripts/generate-operate-contracts.mjs --write",
    "check": "node scripts/generate-operate-contracts.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check:boundaries": "node --test tests/boundaries.test.mjs"
  },
  "openplanr": {
    "domain": "operate",
    "sourceCutoff": "fa591a7e7157b47e10d33e4c30997925779c692e",
    "compatibilityProjection": "lib/operate"
  }
}
