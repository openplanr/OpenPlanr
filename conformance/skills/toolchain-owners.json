{
  "kind": "openplanr-skill-toolchain-owners",
  "schemaVersion": "1.0.0",
  "owners": [
    {
      "role": "prompt-writer",
      "ownerId": "canonical-skill-generator",
      "path": "scripts/skills/generate-v18.mjs",
      "implementationPaths": [
        "scripts/skills/generate-v18.mjs",
        "packages/skill-runtime/src/authoring/generate.mjs"
      ],
      "controls": [
        "standard-skill-packages",
        "host-plugin-distributions"
      ]
    },
    {
      "role": "runtime-installer",
      "ownerId": "cli-runtime-manager",
      "path": "packages/cli/src/services/runtime-manager-service.ts",
      "implementationPaths": [
        "packages/cli/src/services/runtime-manager-service.ts"
      ],
      "controls": [
        "project-runtime-adapters",
        "user-runtime-adapters"
      ]
    }
  ]
}
